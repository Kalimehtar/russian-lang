#!1
используется класс рисование/цвет графический-интерфейс/объект
-- предоставлять стиль-изображения->английский стиль-заполнения->английский комбинировать->английский
--  координаты-точки стандартные-цвета
предоставлять холст-адины
-- предоставлять-для-синтаксиса методы-холста

стиль-изображения->английский стиль =
  если стиль === 'непрозрачный тогда 'opaque иначе 'solid

стиль-заполнения->английский стиль =
  если стиль === 'чёт-нечет тогда 'odd-even иначе 'winding

комбинировать->английский значение =
  если значение === 'графемы тогда 'grapheme иначе значение

координаты-точки точка =
  если список? точка тогда
    значения первый(точка) первый(оставшиеся точка)
    иначе
    значения точка{лево} точка{верх}

стиль-пера->английский стиль =
  выбор стиль
    (прозрачный) 'transparent
    (сплошной) 'solid
    (исключающее-или) 'xor
    (подсветка) 'hilite
    (точки) 'dot
    (длинный-пунктир) 'long-dash
    (короткий-пунктир) 'short-dash
    (штрих-пунктир) 'dot-dash
    (исключающее-или-точки) 'xor-dot
    (исключающее-или-длинный-пунктир) 'xor-long-dash
    (исключающее-или-короткий-пунктир) 'xor-short-dash
    (исключающее-или-штрих-пунктир) 'xor-dot-dash
    иначе стиль

тип-рамки-контура->английский тип =
  выбор тип
    (контур) 'path
    (обводка) 'stroke
    (заливка) 'fill
    иначе тип

режим-сглаживания->английский режим =
  выбор режим
    (без-сглаживания) 'unsmoothed
    (сглаженное) 'smoothed
    (выровненное) 'aligned
    иначе режим

режим-сглаживания->русский режим =
  выбор режим
    (unsmoothed) 'без-сглаживания
    (smoothed) 'сглаженное
    (aligned) 'выровненное
    иначе режим

режим-текста->английский режим =
  выбор режим
    (прозрачный) 'transparent
    (сплошной) 'solid
    иначе режим

режим-текста->русский режим =
  выбор режим
    (transparent) 'прозрачный
    (solid) 'сплошной
    иначе режим

при-компиляции
  методы-холста = '
    ключ-метрики-шрифта() = $внутренний{cache-font-metrics-key}
    залить-фоном() = $внутренний{clear}
    копировать лево верх ширина высота лево-цели верх-цели =
      $внутренний{copy лево верх ширина высота лево-цели верх-цели}
    нарисовать-дугу лево верх ширина высота начальный-угол конечный-угол =
      $внутренний{draw-arc лево верх ширина высота начальный-угол конечный-угол}
    нарисовать-изображение источник лево-цели верх-цели
      стиль 'обычный
      цвет 'чёрный
      маска ложь
      =
      $внутренний{draw-bitmap источник{внутренний} лево-цели верх-цели
                              стиль-изображения->английский(стиль)
                              внутренний-цвет(цвет) внутренний-объект(маска)}
    нарисовать-часть-изображения источник лево-цели верх-цели лево-части верх-части
      ширина-части
      высота-части
      стиль 'обычный
      цвет 'чёрный
      маска ложь
      =
      $внутренний{draw-bitmap-section источник{внутренний} лево-цели верх-цели
                                      лево-части верх-части
                                      ширина-части высота-части
                                      стиль-изображения->английский(стиль)
                                      внутренний-цвет(цвет) внутренний-объект(маска)}
    нарисовать-эллипс лево верх ширина высота =
      $внутренний{draw-ellipse лево верх ширина высота}
    нарисовать-линию лево-начала верх-начала лево-конца верх-конца =
      $внутренний{draw-line лево-начала верх-начала лево-конца верх-конца}
    нарисовать-линии список-линий сместить-вправо(0) сместить-вниз(0) =
      $внутренний{draw-lines список-линий сместить-вправо сместить-вниз}
    нарисовать-контур контур
      сместить-вправо 0
      сместить-вниз 0
      стиль-заполнения 'чёт-нечет
      =
      $внутренний{draw-path внутренний-объект(контур) сместить-вправо
                            сместить-вниз
                            стиль-заполнения->английский(стиль-заполнения)}
    нарисовать-точку лево верх = $внутренний{draw-point лево верх}
    нарисовать-многоугольник точки
      сместить-вправо 0
      сместить-вниз 0
      стиль-заполнения 'чёт-нечет
      =
      $внутренний{draw-polygon точки сместить-вправо сместить-вниз
                               стиль-заполнения->английский(стиль-заполнения)}
    нарисовать-прямоугольник лево верх ширина высота =
      $внутренний{draw-rectangle лево верх ширина высота}
    нарисовать-закруглённый-прямоугольник лево верх ширина высота радиус(-0.25) =
      $внутренний{draw-rounded-rectangle лево верх ширина высота радиус}
    нарисовать-лекало начало контрольная-точка конец =
      значения лево1 верх1 = координаты-точки начало
      значения лево2 верх2 = координаты-точки контрольная-точка
      значения лево3 верх3 = координаты-точки конец
      $внутренний{draw-spline лево1 верх1 лево2 верх2 лево3 верх3}
    нарисовать-текст текст лево верх комбинировать(ложь) начальная-литера(0) угол(0) =
      $внутренний{draw-text текст лево верх комбинировать->английский(комбинировать)
                            начальная-литера угол}
    начать-слой прозрачность = $внутренний{start-alpha прозрачность}
    закончить-слой() = $внутренний{end-alpha}
    начать-документ сообщение = $внутренний{start-doc сообщение}
    закончить-документ() = $внутренний{end-doc}
    начать-страницу() = $внутренний{start-page}
    закончить-страницу() = $внутренний{end-page}
    очистить() = $внутренний{erase}
    отрисовать-немедленно() = $внутренний{flush}
    прозрачность = функция-выбора
      () $внутренний{get-alpha}
      (новое-значение) $внутренний{set-alpha новое-значение}
    фон = функция-выбора
      () $внутренний{get-background}
      (новое-значение) $внутренний{set-background новое-значение}
    цвет-текста = функция-выбора
      () $внутренний{get-text-foreground}
      (новое-значение) $внутренний{set-text-foreground внутренний-цвет(новое-значение)}
    кисть = функция-выбора
      () $внутренний{get-brush}
      (новое-значение) $внутренний{set-brush новое-значение}
      (цвет стиль) $внутренний{set-brush внутренний-цвет(цвет) стиль-изображения->английский(стиль)}
    масштаб = функция-выбора
      () $внутренний{get-scale}
      (по-ширине по-высоте) $внутренний{set-scale по-ширине по-высоте}
    масштаб-подложки() = $внутренний{get-backing-scale}
    высота-литеры() = $внутренний{get-char-height}
    ширина-литеры() = $внутренний{get-char-width}
    область-отсечения = функция-выбора
      () $внутренний{get-clipping-region}
      (значение) $внутренний{set-clipping-region внутренний-объект(значение)}
    отсечь-прямоугольник лево верх ширина высота =
      $внутренний{set-clipping-rect лево верх ширина высота}
    масштаб-устройства() = $внутренний{get-device-scale}
    шрифт = функция-выбора
      () $внутренний{get-font}
      (новое-значение) $внутренний{set-font внутренний-объект(новое-значение)}
    контекст-opengl() = $внутренний{get-gl-context}
    начальная-матрица = функция-выбора
      () $внутренний{get-initial-matrix}
      (матрица) $внутренний{set-initial-matrix матрица}
    начало-координат = функция-выбора
      () $внутренний{get-origin}
      (лево верх) $внутренний{set-origin лево верх}
    перо = функция-выбора
      () $внутренний{get-pen}
      (новое-значение) $внутренний{set-pen внутренний-объект(новое-значение)}
      (цвет толщина стиль)
        $внутренний{set-pen внутренний-цвет(цвет) толщина
                            стиль-пера->английский(стиль)}
    рамка-контура контур тип =
      $внутренний{get-path-bounding-box внутренний-объект(контур)
                                        тип-рамки-контура->английский(тип)}
    поворот = функция-выбора
      () $внутренний{get-rotation}
      (угол) $внутренний{set-rotation угол}
    размер() = $внутренний{get-size}
    сглаживание = функция-выбора
      () режим-сглаживания->русский($внутренний{get-smoothing})
      (режим) $внутренний{set-smoothing режим-сглаживания->английский(режим)}
    цвет-фона-текста = функция-выбора
      () $внутренний{get-text-background}
      (цвет) $внутренний{set-text-background внутренний-цвет(цвет)}
    размеры-текста текст
      шрифт ложь
      комбинировать ложь
      начальная-литера 0
      =
      шрифт* = шрифт && внутренний-объект(шрифт)
      $внутренний{get-text-extent текст шрифт*
                                  комбинировать->английский(комбинировать)
                                  начальная-литера}
    режим-текста = функция-выбора
      () режим-текста->русский($внутренний{get-text-mode})
      (режим) $внутренний{set-text-mode режим-текста->английский(режим)}
    преобразование = функция-выбора
      () $внутренний{get-transformation}
      (значение) $внутренний{set-transformation значение}
    есть-литера? литера = $внутренний{glyph-exists? литера}
    работает?() = $внутренний{ok?}
    продолжить-отрисовку() = $внутренний{resume-flush}
    приостановить-отрисовку() = $внутренний{suspend-flush}
    повернуть угол = $внутренний{rotate угол}
    масштабировать по-ширине по-высоте =
      $внутренний{scale по-ширине по-высоте}
    масштаб-выравнивания значение =
      $внутренний{set-alignment-scale значение}
    преобразовать матрица = $внутренний{transform матрица}
    сдвинуть вправо вниз = $внутренний{translate вправо вниз}
    подобрать-цвет проба результат =
      $внутренний{try-color внутренний-цвет(проба) внутренний-цвет(результат)}

холст% = сформировать-код $ #` класс объект-графического-интерфейса%
  #,@начало
  методы #,@(отобразить имя-метода методы-холста)
  инициализировать
    $$внутренний(внутренний) ложь
  $внутренний := $$внутренний
  #,@методы-холста

холст-адины внутренний =
  объект холст% внутренний(внутренний)
