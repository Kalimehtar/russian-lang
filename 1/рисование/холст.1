#!1
используется класс рисование/цвет графический-интерфейс/объект
-- предоставлять стиль-изображения->английский стиль-заполнения->английский комбинировать->английский
--  координаты-точки стандартные-цвета
предоставлять холст-адины
-- предоставлять-для-синтаксиса методы-холста

стиль-изображения->английский стиль =
  если стиль === 'непрозрачный тогда 'opaque иначе 'solid

стиль-заполнения->английский стиль =
  если стиль === 'чёт-нечет тогда 'odd-even иначе 'winding

комбинировать->английский значение =
  если значение === 'графемы тогда 'grapheme иначе значение

координаты-точки точка =
  если список? точка тогда
    значения первый(точка) первый(оставшиеся точка)
    иначе
    значения точка{лево} точка{верх}

сделать-цвет символ-или-цвет =
  если символ? символ-или-цвет тогда
    стандартные-цвета{найти символ-или-цвет}
    иначе
    символ-или-цвет

при-компиляции
  методы-холста = '
    ключ-метрики-шрифта() = $внутренний{cache-font-metrics-key}
    залить-фоном() = $внутренний{clear}
    копировать лево верх ширина высота лево-цели верх-цели =
      $внутренний{copy лево верх ширина высота лево-цели верх-цели}
    нарисовать-дугу лево верх ширина высота начальный-угол конечный-угол =
      $внутренний{draw-arc лево верх ширина высота начальный-угол конечный-угол}
    нарисовать-изображение источник лево-цели верх-цели
      стиль 'обычный
      цвет стандартные-цвета{найти 'чёрный}
      маска ложь
      =
      $внутренний{draw-bitmap источник лево-цели верх-цели стиль-изображения->английский(стиль)
                              цвет маска}
    нарисовать-часть-изображения источник лево-цели верх-цели лево-части верх-части
      ширина-части
      высота-части
      стиль 'обычный
      цвет стандартные-цвета{найти 'чёрный}
      маска ложь
      =
      $внутренний{draw-bitmap-section источник лево-цели верх-цели лево-части верх-части
                                      ширина-части высота-части
                                      стиль-изображения->английский(стиль) цвет маска}
    нарисовать-эллипс лево верх ширина высота =
      $внутренний{draw-ellipse лево верх ширина высота}
    нарисовать-линию лево-начала верх-начала лево-конца верх-конца =
      $внутренний{draw-line лево-начала верх-начала лево-конца верх-конца}
    нарисовать-линии список-линий сместить-вправо(0) сместить-вниз(0) =
      $внутренний{draw-lines список-линий сместить-вправо сместить-вниз}
    нарисовать-контур контур
      сместить-вправо 0
      сместить-вниз 0
      стиль-заполнения 'чёт-нечет
      =
      $внутренний{draw-path контур сместить-вправо сместить-вниз
                            стиль-заполнения->английский(стиль-заполнения)}
    нарисовать-точку лево верх = $внутренний{draw-point лево верх}
    нарисовать-многоугольник точки
      сместить-вправо 0
      сместить-вниз 0
      стиль-заполнения 'чёт-нечет
      =
      $внутренний{draw-polygon точки сместить-вправо сместить-вниз
                               стиль-заполнения->английский(стиль-заполнения)}
    нарисовать-прямоугольник лево верх ширина высота =
      $внутренний{draw-rectangle лево верх ширина высота}
    нарисовать-закруглённый-прямоугольник лево верх ширина высота радиус(-0.25) =
      $внутренний{draw-rounded-rectangle лево верх ширина высота радиус}
    нарисовать-лекало начало контрольная-точка конец =
      значения лево1 верх1 = координаты-точки начало
      значения лево2 верх2 = координаты-точки контрольная-точка
      значения лево3 верх3 = координаты-точки конец
      $внутренний{draw-spline лево1 верх1 лево2 верх2 лево3 верх3}
    нарисовать-текст текст лево верх комбинировать(ложь) начальная-литера(0) угол(0) =
      $внутренний{draw-text лево верх комбинировать->английский(комбинировать) начальная-литера угол}
    начать-слой прозрачность = $внутренний{start-alpha прозрачность}
    закончить-слой() = $внутренний{end-alpha}
    начать-документ сообщение = $внутренний{start-doc сообщение}
    закончить-документ() = $внутренний{end-doc}
    начать-страницу() = $внутренний{start-page}
    закончить-страницу() = $внутренний{end-page}
    очистить() = $внутренний{erase}
    отрисовать-немедленно() = $внутренний{flush}
    прозрачность = функция-выбора
      () $внутренний{get-alpha}
      (новое-значение) $внутренний{set-alpha новое-значение}
    фон = функция-выбора
      () $внутренний{get-background}
      (новое-значение) $внутренний{set-background новое-значение}
    кисть = функция-выбора
      () $внутренний{get-brush}
      (новое-значение) $внутренний{set-brush новое-значение}
      (цвет стиль) $внутренний{set-brush сделать-цвет(цвет) стиль-изображения->английский(стиль)}

холст% = сформировать-код $ #` класс объект-графического-интерфейса%
  #,@начало
  методы #,@(отобразить имя-метода методы-холста)
  инициализировать
    $$внутренний(внутренний) ложь
  $внутренний := $$внутренний
  #,@методы-холста

холст-адины внутренний =
  объект холст% внутренний(внутренний)
