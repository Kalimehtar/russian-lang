#!1
используется класс
  с-префиксом rkt: racket/draw
предоставлять стандартные-цвета

стандартные-цвета = объект
  класс объект%
    базовый-объект()
    методы найти имена
    найти имя =
      перевод = выбор имя
        (белый) "white"
        (синий) "blue"
        (голубой) "cornflowerblue"
        (красный) "red"
        (оранжевый) "orange"
        (чёрный) "black"
        (жёлтый) "yellow"
        иначе имя
      rkt:the-color-database{find-color перевод}
    имена() = rkt:the-color-database{get-names}