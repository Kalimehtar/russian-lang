#!1
используется класс графический-интерфейс/объект
  с-префиксом rkt: racket/draw
предоставлять стандартные-цвета внутренний-цвет цвет%

стандартные-цвета = объект
  класс объект%
    базовый-объект()
    методы найти имена
    найти имя =
      перевод = выбор имя
        (белый) "white"
        (синий) "blue"
        (голубой) "cornflowerblue"
        (красный) "red"
        (оранжевый) "orange"
        (чёрный) "black"
        (жёлтый) "yellow"
        (зелёный) "green"
        (тёмно-зелёный) "dark green"
        (серый) "gray"
        иначе имя -- если попали сюда, имя должно быть строкой
      rkt:the-color-database{find-color перевод}
    имена() = rkt:the-color-database{get-names}

цвет% = сформировать-код $ #` класс объект-графического-интерфейса%
  #,@начало
  инициализировать
    $красный(красный) 0
    $зелёный(зелёный) 0
    $синий(синий) 0
    $укрывистость(укрывистость) 0.0
    образец ложь
    $$внутренний(внутренний) ложь
  $внутренний := если
    ($$внутренний)
      $$внутренний
    образец
      создать-объект rkt:color%
        внутренний-цвет образец
    иначе
      создать-объект rkt:color% $красный $зелёный $синий $укрывистость

внутренний-цвет образец =
  если
    объект-класса?(образец цвет%)
      образец{внутренний}
    символ?(образец)
      стандартные-цвета{найти образец}
    иначе
      образец
