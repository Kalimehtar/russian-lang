#!1
используется класс
  графический-интерфейс/объект
  графический-интерфейс/интерфейс-элемент-управления
  графический-интерфейс/шрифт
  графический-интерфейс/событие
  с-префиксом rkt: racket/gui/base

предоставлять ползунок%

стиль->английский список-терминов =
  отобразить
    функция (термин)
      выбор термин
        (горизонтальный) 'horizontal
        (вертикальный) 'vertical
        (вверх) 'upward
        (простой) 'plain
        (вертикальный-заголовок) 'vertical-label
        (горизонтальный-заголовок) 'horizontal-label
        (скрытая) 'deleted
    список-терминов

внутренний-ползунка% = сформировать-код $ #` класс* rkt:slider% \
  (внутренний-адины<%>)
  #,@начало-внутреннего
  переопределить #,@(отобразить имя-метода события-элемента-управления)
  #,@события-элемента-управления

ползунок% = сформировать-код $ #` класс* объект-графического-интерфейса% \
  (элемент-управления<%>)
  #,@начало
  методы #,@(отобразить имя-метода методы-элемента-управления) значение
  инициализировать
    $минимум(минимум)()
    $максимум(максимум)()
    #,@(убрать-инициализацию 'стиль инициализация-элемента-управления)
    $заголовок(заголовок) ложь
    $значение(значение) ложь
    $стиль(стиль) '(горизонтальный)
    $команда(команда)
      функция (ползунок событие) пусто
  если пустой?($стиль) тогда
    $стиль := '(горизонтальный)
  $внутренний := объект внутренний-ползунка%
    получатель-событий этот
    label
      внутренний-объект $заголовок
    min-value $минимум
    max-value $максимум
    init-value
      если $значение === ложь тогда $минимум иначе $значение
    callback
      функция (элемент событие)
        $команда
          объект-адины элемент
          событие-управления-адины событие
    #,@внутренняя-инициализация-элемента-управления
  #,@методы-элемента-управления
  значение = функция-выбора
    () $внутренний{get-value}
    (новое-значение) $внутренний{set-value новое-значение}
