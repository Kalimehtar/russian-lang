#!1
используется класс
  графический-интерфейс/объект
  с-префиксом rkt: racket/gui/base

предоставлять таймер%

внутренний-таймера% = сформировать-код $ #` класс* rkt:timer% \
  (внутренний-адины<%>)
  #,@начало-внутреннего
  переопределить notify
  notify() =
    получатель-событий{уведомить}

таймер% = сформировать-код $ #` класс объект-графического-интерфейса%
  #,@начало
  методы интервал запустить остановить уведомить
  инициализированные-поля
    $команда(команда)
      функция () пусто
  инициализировать
    $интервал(интервал) ложь
    $один-раз?(один-раз?) ложь
  $внутренний := объект внутренний-таймера%
    получатель-событий этот
    notify-callback
      функция () пусто
    interval $интервал
    just-once? $один-раз?
  интервал() = $внутренний{interval}
  запустить миллисекунды один-раз?(ложь) =
    $внутренний{start миллисекунды один-раз?}
  остановить() = $внутренний{stop}
  уведомить() = $команда()
