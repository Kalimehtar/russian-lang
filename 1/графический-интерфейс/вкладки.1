#!1
используется класс
  графический-интерфейс/объект
  графический-интерфейс/панель
  графический-интерфейс/интерфейс-вместилище-окно
  графический-интерфейс/интерфейс-подобласть
  графический-интерфейс/шрифт
  графический-интерфейс/событие
  с-префиксом rkt: racket/gui/base

предоставлять вкладки%

стиль->английский список-терминов =
  отобразить
    функция (термин)
      выбор термин
        (без-рамки) 'no-border
        (переставляемые) 'can-reorder
        (закрываемые) 'can-close
        (кнопка-новой) 'new-button
        (скрытая) 'deleted
    список-терминов

внутренний-вкладок% = сформировать-код $ #` класс* rkt:tab-panel% \
  (внутренний-адины<%>)
  #,@начало-внутреннего
  переопределить #,@(отобразить имя-метода события-вместилища-окна)
  переопределить on-close-request on-new-request
  дополнить on-reorder
  методы #,@(отобразить имя-метода внутренние-методы-вместилища-окна)
  #,@события-вместилища-окна
  #,@внутренние-методы-вместилища-окна
  on-reorder прежние-индексы =
    получатель-событий{при-перестановке прежние-индексы}
  on-close-request индекс =
    получатель-событий{при-закрытии-вкладки индекс}
  on-new-request() =
    получатель-событий{при-добавлении-вкладки}

вкладки% = сформировать-код $ #` класс панель%
  унаследованные-поля $внутренний
  методы выделение количество добавить удалить заголовок-вкладки установить \
    при-перестановке при-закрытии-вкладки при-добавлении-вкладки
  базовый-объект
    родитель ложь
    внутренний истина
  инициализировать
    $вкладки(вкладки)()
    #,@(инициализация-вместилища-окна ''(центр верх))
    #,@(добавлена-инициализация-подобласти 0)
    $стиль(стиль) пустой-список
    $шрифт(шрифт) шрифт-элемента-управления
    $команда(команда)
      функция (вкладки событие) пусто
    $$внутренний(внутренний) ложь
  $внутренний := $$внутренний
  если не $внутренний тогда
    $внутренний := объект внутренний-вкладок%
      получатель-событий этот
      choices $вкладки
      callback
        функция (элемент событие)
          $команда
            объект-адины элемент
            событие-управления-адины событие
      style стиль->английский($стиль)
      font $шрифт{внутренний}
      #,@внутренняя-инициализация-вместилища-окна()
      #,@добавлена-внутренняя-инициализация-подобласти
  выделение = функция-выбора
    () $внутренний{get-selection}
    (новое-значение) $внутренний{set-selection новое-значение}
  количество() = $внутренний{get-number}
  добавить подпись = $внутренний{append подпись}
  удалить индекс = $внутренний{delete индекс}
  заголовок-вкладки = функция-выбора
    (индекс) $внутренний{get-item-label индекс}
    (индекс новая-подпись) $внутренний{set-item-label индекс новая-подпись}
  установить вкладки = $внутренний{set вкладки}
  при-перестановке прежние-индексы = пусто
  при-закрытии-вкладки индекс = пусто
  при-добавлении-вкладки() = пусто
