#!1
используется класс
  графический-интерфейс/объект
  графический-интерфейс/интерфейс-картина
  графический-интерфейс/событие
  рисование/холст  
  с-префиксом rkt: racket/gui/base  
предоставлять картина%

стиль->английский список-терминов =
  отобразить
    функция (термин)
      выбор термин
        (рамка) 'border
        (рамка-элемента-управления) 'control-border
        (комбинированное) 'combo
        (горизонтальная-прокрутка) 'hscroll
        (вертикальная-прокрутка) 'vscroll
        (угол-изменения-размера) 'resize-corner
        (трёхмерная) 'gl
        (без-автоочистки) 'no-autoclear
        (прозрачная) 'transparent
        (без-фокуса) 'no-focus
        (скрытая) 'deleted
    список-терминов

внутренний-картины% = сформировать-код $ #` класс rkt:canvas%
  #,@начало-внутреннего
  переопределить #,@(отобразить имя-метода события-картины)
  #,@события-картины

картина% = сформировать-код $ #` класс* объект-графического-интерфейса% (картина<%>)
  базовый-объект()
  методы #,@(отобразить имя-метода методы-картины)
  инициализировать
    #,@инициализация-картины(0)
    $заголовок(заголовок) ложь
    $стиль(стиль) '()
    $обработка(обработка-перерисовки)
      функция (картина холст) пусто
  $внутренний = объект внутренний-картины%
    получатель-событий этот
    label $заголовок
    style стиль->английский($стиль)
    paint-callback
      функция (картина холст-базы)
        $обработка картина холст-адины(холст-базы)
    #,@внутренняя-инициализация-картины
  #,@методы-картины
