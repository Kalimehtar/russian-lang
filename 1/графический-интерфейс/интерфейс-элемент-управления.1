#!1
используется класс графический-интерфейс/объект графический-интерфейс/интерфейс-подокно
    графический-интерфейс/событие
предоставлять элемент-управления<%> стиль->английский событие-мыши-адины событие-клавиши-адины
предоставлять-для-синтаксиса события-элемента-управления методы-элемента-управления \
  инициализация-элемента-управления внутренняя-инициализация-элемента-управления

элемент-управления<%> = интерфейс (подокно<%>)

стиль->английский список-терминов =
  отобразить
    функция (термин)
      выбор термин
        (скрытая) 'deleted
    список-терминов

при-компиляции
  события-элемента-управления = события-подокна
  методы-элемента-управления = методы-подокна ++ '
    $ команда событие = $внутренний{command событие}
  инициализация-элемента-управления =
    убрать-инициализацию 'растягивается-ширина
      убрать-инициализацию 'растягивается-высота
        инициализация-подокна 2
    ++
    '
      $растягивается-ширина(растягивается-ширина) ложь
      $растягивается-высота(растягивается-высота) ложь
      $шрифт(шрифт) шрифт-элемента-управления
      $стиль(стиль) '()
  внутренняя-инициализация-элемента-управления = внутренняя-инициализация-подокна ++
    '
      font $шрифт{внутренний}
      style стиль->английский($стиль)
