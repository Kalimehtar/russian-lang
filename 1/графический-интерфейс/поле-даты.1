#!1
используется класс
  графический-интерфейс/объект
  графический-интерфейс/текстовое-поле
  графический-интерфейс/интерфейс-элемент-управления
  графический-интерфейс/шрифт
  графический-интерфейс/событие
  с-префиксом rkt: text-date
предоставлять поле-даты%

внутренний-поля-даты% = сформировать-код $ #` класс rkt:date-text-field%
  #,@начало-внутреннего

стиль->английский список-терминов =
  отобразить
    функция (термин)
      выбор термин
        (однострочное) 'single
        (многострочное) 'multiple
        (скрытая) 'deleted
    список-терминов

при-компиляции
  инициализация-текстового-поля = 
    убрать-инициализацию 'стиль
      убрать-инициализацию 'растягивается-ширина
        инициализация-элемента-управления
    ++
    '
      $растягивается-ширина(растягивается-ширина) истина
      $стиль(стиль) '(однострочное)

поле-даты% = сформировать-код $ #` класс текстовое-поле%
  унаследованные-поля $внутренний
  инициализировать
    #,@инициализация-текстового-поля
    $заголовок(заголовок) ложь
    $значение(значение) «»
    $при-изменении(при-изменении) ложь
  базовый-объект
    родитель $родитель
    внутренний $ объект внутренний-поля-даты%
      получатель-событий этот
      label $заголовок
      init-value $значение
      callback
        $при-изменении ?
          функция (элемент событие)
            $при-изменении
              объект-адины элемент
              событие-управления-адины событие
          функция (элемент событие) пусто
      #,@внутренняя-инициализация-элемента-управления
