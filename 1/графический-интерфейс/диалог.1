#!1
используется класс
  с-префиксом rkt: racket/gui/base
  графический-интерфейс/объект
  графический-интерфейс/интерфейс-окно
  графический-интерфейс/интерфейс-главное-окно
  графический-интерфейс/событие

предоставлять диалог% получить-файл сохранить-файл

стиль-диалога->английский список-терминов =
  отобразить
    функция (термин)
      выбор термин
        (без-заголовка) 'no-caption
        (рамка-изменения-размера) 'resize-border
        (без-листа) 'no-sheet
        (кнопка-закрытия) 'close-button
    список-терминов

при-компиляции
  имена-методов-окна = отобразить имя-метода методы-окна
  имена-методов-главного-окна = отобразить имя-метода методы-главного-окна

внутренний-диалога% = сформировать-код $ #` класс* rkt:dialog% (внутренний-адины<%>)
  #,@начало-внутреннего
  переопределить #,@(отобразить имя-метода события-главного-окна)
  #,@события-главного-окна

диалог% = сформировать-код $ #` класс* объект-графического-интерфейса% (главное-окно<%>)
  #,@начало
  методы #,@имена-методов-главного-окна
  инициализировать
    #,@инициализация-главного-окна
    $заголовок(заголовок) ""
    $ширина(ширина) ложь
    $высота(высота) ложь
    $лево(лево) ложь
    $верх(верх) ложь
    $стиль(стиль) пустой-список
  $внутренний := объект внутренний-диалога%
    получатель-событий этот
    label $заголовок
    width $ширина
    height $высота
    x $лево
    y $верх
    style стиль-диалога->английский($стиль)
    #,@внутренняя-инициализация-главного-окна
  #,@методы-главного-окна

получить-файл
  сообщение ложь
  родитель ложь
  каталог ложь
  имя-файла ложь
  расширение ложь
  стиль пустой-список
  фильтры '((«Любые» «*.*»))
  =
  rkt:get-file сообщение внутренний-объект(родитель) каталог имя-файла расширение стиль
    фильтры

сохранить-файл
  сообщение ложь
  родитель ложь
  каталог ложь
  имя-файла ложь
  расширение ложь
  стиль пустой-список
  фильтры '((«Любые» «*.*»))
  =
  rkt:put-file сообщение внутренний-объект(родитель) каталог имя-файла расширение стиль
    фильтры
