#!1
используется класс
  графический-интерфейс/объект
  графический-интерфейс/списочный-интерфейс
  графический-интерфейс/интерфейс-элемент-управления
  графический-интерфейс/шрифт
  графический-интерфейс/событие
  с-префиксом rkt: racket/gui/base

предоставлять список%

стиль->английский список-терминов =
  отобразить
    функция (термин)
      выбор термин
        (одиночный) 'single
        (множественный) 'multiple
        (расширенный) 'extended
        (вертикальный-заголовок) 'vertical-label
        (горизонтальный-заголовок) 'horizontal-label
        (изменяемые-колонки) 'variable-columns
        (заголовки-колонок) 'column-headers
        (нажимаемые-заголовки) 'clickable-headers
        (переставляемые-заголовки) 'reorderable-headers
        (скрытая) 'deleted
    список-терминов

при-компиляции
  инициализация-списка =
    убрать-инициализацию 'стиль
      убрать-инициализацию 'растягивается-ширина
        убрать-инициализацию 'растягивается-высота
          инициализация-элемента-управления
    ++
    '
      $растягивается-ширина(растягивается-ширина) истина
      $растягивается-высота(растягивается-высота) истина
      $стиль(стиль) '(одиночный)
  методы-поля-списка = '
    добавить строка данные(ложь) = $внутренний{append строка данные}
    строка = функция-выбора
      (индекс) $внутренний{get-string индекс}
      (индекс значение) $внутренний{set-string индекс значение 0}
      (индекс значение колонка) $внутренний{set-string индекс значение колонка}
    добавить-колонку заголовок = $внутренний{append-column заголовок}
    удалить-колонку индекс = $внутренний{delete-column индекс}
    заголовки-колонок() = $внутренний{get-column-labels}
    порядок-колонок = функция-выбора
      () $внутренний{get-column-order}
      (новое-значение) $внутренний{set-column-order новое-значение}
    ширина-колонки = функция-выбора
      (колонка) $внутренний{get-column-width колонка}
      (колонка ширина минимум максимум)
        $внутренний{set-column-width колонка ширина минимум максимум}
    данные = функция-выбора
      (индекс) $внутренний{get-data индекс}
      (индекс значение) $внутренний{set-data индекс значение}
    первый-видимый = функция-выбора
      () $внутренний{get-first-visible-item}
      (новое-значение) $внутренний{set-first-visible-item новое-значение}
    шрифт-заголовка() = $внутренний{get-label-font}
    выделения() = $внутренний{get-selections}
    выделен? индекс = $внутренний{is-selected? индекс}
    число-видимых() = $внутренний{number-of-visible-items}
    выделить индекс выделен?(истина) = $внутренний{select индекс выделен?}
    установить-элементы элементы = $внутренний{set элементы}

внутренний-списка% = сформировать-код $ #` класс rkt:list-box%
  #,@начало-внутреннего
  переопределить #,@(отобразить имя-метода события-элемента-управления)
  #,@события-элемента-управления

список% = сформировать-код $ #` класс* объект-графического-интерфейса% (список<%>)
  #,@начало
  методы #,@(отобразить имя-метода
    $ (убрать 'добавить $ убрать 'строка методы-списка) ++ методы-поля-списка)
  инициализировать
    $элементы(элементы)()
    #,@инициализация-списка
    $заголовок(заголовок) ложь
    $команда(команда)
      функция (список событие) пусто
    $выделение(выделение) ложь
    $шрифт-заголовка(шрифт-заголовка) шрифт-элемента-управления
    $колонки(колонки) '(«Колонка»)
    $порядок-колонок(порядок-колонок) ложь
  $внутренний := объект внутренний-списка%
    получатель-событий этот
    label $заголовок
    choices $элементы
    callback
      функция (элемент событие)
        $команда
          объект-адины элемент
          событие-управления-адины событие
    selection $выделение
    label-font $шрифт-заголовка{внутренний}
    columns $колонки
    column-order $порядок-колонок
    #,@внутренняя-инициализация-элемента-управления
  #,@(убрать 'добавить $ убрать 'строка методы-списка)
  #,@методы-поля-списка
