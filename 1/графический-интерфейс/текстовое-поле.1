#!1
используется класс
  графический-интерфейс/объект
  графический-интерфейс/интерфейс-элемент-управления
  графический-интерфейс/шрифт
  графический-интерфейс/событие
  с-префиксом rkt: racket/gui/base
предоставлять текстовое-поле%

внутренний-текстового-поля% = сформировать-код $ #` класс rkt:text-field%
  #,@начало-внутреннего
  переопределить #,@(отобразить имя-метода события-элемента-управления)
  #,@события-элемента-управления

стиль->английский список-терминов =
  отобразить
    функция (термин)
      выбор термин
        (однострочное) 'single
        (многострочное) 'multiple
        (скрытая) 'deleted
    список-терминов

при-компиляции
  инициализация-текстового-поля = 
    убрать-инициализацию 'стиль
      убрать-инициализацию 'растягивается-ширина
        инициализация-элемента-управления
    ++
    '
      $растягивается-ширина(растягивается-ширина) истина
      $стиль(стиль) '(однострочное)

текстовое-поле% = сформировать-код $ #` класс* объект-графического-интерфейса% (элемент-управления<%>)
  #,@начало
  методы #,@(отобразить имя-метода методы-элемента-управления) значение
  инициализировать
    #,@инициализация-текстового-поля
    $заголовок(заголовок) ложь
    $значение(значение) «»
    $при-изменении(при-изменении) ложь
  если не $внутренний тогда
    $внутренний := объект внутренний-текстового-поля%
      получатель-событий этот
      label $заголовок
      init-value $значение
      callback
        $при-изменении ?
          функция (элемент событие)
            $при-изменении
              объект-адины элемент
              событие-управления-адины событие
          функция (элемент событие) пусто
      #,@внутренняя-инициализация-элемента-управления
  #,@методы-элемента-управления
  значение = функция-выбора
    () объект-адины $внутренний{get-value}
    (новое-значение) $внутренний{set-value новое-значение}
