#!1
используется класс графический-интерфейс/объект
  с-префиксом rkt: racket/gui/base

предоставлять набор-команд% набор-команд-адины

при-компиляции
  методы-набора-команд = '
    добавить-функцию имя функция = $внутренний{add-function имя функция}
    есть-функция? имя = $внутренний{is-function-added? имя}
    отменить-последовательность() = $внутренний{break-sequence}
    вызвать-функцию имя источник событие = $внутренний{call-function имя источник событие}
    функция-команды команда функция = $внутренний{map-function команда функция}

набор-команд% = сформировать-код $ #` класс* объект-графического-интерфейса% ()
  #,@начало
  методы #,@(отобразить имя-метода методы-набора-команд)
  инициализировать
    $$внутренний(внутренний)
      объект rkt:keymap%
  $внутренний := $$внутренний
  #,@методы-набора-команд

набор-команд-адины внутренний =
  объект набор-команд% внутренний(внутренний)
