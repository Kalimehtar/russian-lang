#!1
используется класс графический-интерфейс/интерфейс-подокно
предоставлять редактор<%>
предоставлять-для-синтаксиса методы-редактора

редактор<%> = интерфейс () добавить-картину

при-компиляции
  методы-редактора = '
    добавить-картину картина = $внутренний{add-canvas картина}
    добавить-отменятель отменятель = $внутренний{add-undo отменятель}
    начать-последовательность-редактирования() = $внутренний{begin-edit-sequence}
    закончить-последовательность-редактирования() = $внутренний{end-edit-sequence}
    очистить() = $внутренний{erase}
    команды-редактора = функция-выбора
      () набор-команд-адины $внутренний{get-keymap}
      (новое-значение) $внутренний{set-keymap внутренний-объект(новое-значение)}
    первый-кусок() =
      кусок-адины $внутренний{find-first-snip}
