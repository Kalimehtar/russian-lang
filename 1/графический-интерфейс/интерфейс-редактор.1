#!1
используется класс графический-интерфейс/интерфейс-подокно
  с-префиксом rkt-base: racket/gui/base
предоставлять редактор<%>
предоставлять-для-синтаксиса методы-редактора события-редактора дополняемые-события-редактора

редактор<%> = интерфейс () добавить-картину

при-компиляции
  дополняемые-события-редактора = '
    on-display-size() = получатель-событий{при-изменении-размера}
    on-edit-sequence() = получатель-событий{при-начале-последовательности-редактировании}
  события-редактора = '
    on-default-event событие =
      получатель-событий{при-получении-необработанного-события событие-мыши-адины(событие)} \
        && базовый on-default-event событие
    on-event событие =
      получатель-событий{при-получении-события событие-мыши-адины(событие)} \
        && базовый on-event событие    
  методы-редактора = '
    добавить-картину картина = $внутренний{add-canvas картина}
    добавить-отменятель отменятель = $внутренний{add-undo отменятель}
    начать-последовательность-редактирования() = $внутренний{begin-edit-sequence}
    закончить-последовательность-редактирования() = $внутренний{end-edit-sequence}
    очистить() = $внутренний{erase}
    команды-редактора = функция-выбора
      ()
        набор-команд-адины $внутренний{get-keymap}
      (новое-значение) $внутренний{set-keymap внутренний-объект(новое-значение)}
    первый-кусок() =
      $внутренний && кусок-адины $внутренний{find-first-snip}
    вставить-из-буфера время(0) = $внутренний{paste время}
    при-получении-необработанного-события событие = истина
    при-получении-события событие = истина
    при-изменении-размера() = пусто
    при-начале-последовательности-редактировании() = пусто
    размеры() =
      ширина = rkt-base:box 0.0
      высота = rkt-base:box 0.0
      если $внутренний тогда
        $внутренний{get-view-size ширина высота}
      значения rkt-base:unbox(ширина) rkt-base:unbox(высота)
    обработать-изменение-размера() = $внутренний{on-display-size-when-ready}
    глобальные->местные лево верх =
      лево* = rkt-base:box лево
      верх* = rkt-base:box верх
      если $внутренний тогда
        $внутренний{global-to-local лево* верх*}
      значения rkt-base:unbox(лево*) rkt-base:unbox(верх*)
    максимальная-ширина = функция-выбора
      () $внутренний{get-max-width}
      (новое-значение) $внутренний{set-max-width новое-значение}
    минимальная-ширина = функция-выбора
      () $внутренний{get-min-width}
      (новое-значение) $внутренний{set-min-width новое-значение}
    максимальная-высота = функция-выбора
      () $внутренний{get-max-height}
      (новое-значение) $внутренний{set-max-height новое-значение}
    минимальная-высота = функция-выбора
      () $внутренний{get-min-height}
      (новое-значение) $внутренний{set-min-height новое-значение}
