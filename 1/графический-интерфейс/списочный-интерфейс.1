#!1
используется класс графический-интерфейс/интерфейс-элемент-управления
предоставлять список<%>
предоставлять-для-синтаксиса методы-списка

список<%> = интерфейс (элемент-управления<%>) добавить очистить удалить найти-строку \
  количество выделение строка выбранная-строка

при-компиляции
  методы-списка = методы-элемента-управления ++ '
    добавить строка = $внутренний{append строка}
    очистить() = $внутренний{clear}
    удалить индекс = $внутренний{delete индекс}
    найти-строку строка = $внутренний{find-string строка}
    количество() = $внутренний{get-number}
    выделение = функция-выбора
      () $внутренний{get-selection}
      (новое-значение) $внутренний{set-selection новое-значение}
    строка индекс = $внутренний{get-string индекс}
    выбранная-строка = функция-выбора
      () $внутренний{get-string-selection}
      (новое-значение) $внутренний{set-string-selection новое-значение}
