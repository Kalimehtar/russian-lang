#!1
используется класс
  графический-интерфейс/объект
  графический-интерфейс/интерфейс-элемент-управления
  графический-интерфейс/шрифт
  графический-интерфейс/событие
  графический-интерфейс/меню
  с-префиксом rkt: racket/gui/base

предоставлять поле-выбора%

стиль->английский список-терминов =
  отобразить
    функция (термин)
      выбор термин
        (вертикальный-заголовок) 'vertical-label
        (горизонтальный-заголовок) 'horizontal-label
        (скрытая) 'deleted
    список-терминов

при-компиляции
  инициализация-поля-выбора =
    убрать-инициализацию 'стиль
      убрать-инициализацию 'растягивается-ширина
        инициализация-элемента-управления
    ++
    '
      $растягивается-ширина(растягивается-ширина) истина
      $стиль(стиль) '()

внутренний-поля-выбора% = сформировать-код $ #` класс* rkt:combo-field% \
  (внутренний-адины<%>)
  #,@начало-внутреннего
  переопределить #,@(отобразить имя-метода события-элемента-управления)
  переопределить on-popup
  #,@события-элемента-управления
  on-popup событие =
    получатель-событий{при-всплытии событие-управления-адины(событие)}

поле-выбора% = сформировать-код $ #` класс* объект-графического-интерфейса% \
  (элемент-управления<%>)
  #,@начало
  методы #,@(отобразить имя-метода методы-элемента-управления) \
    значение добавить меню при-всплытии
  инициализировать
    $элементы(элементы)()
    #,@инициализация-поля-выбора
    $заголовок(заголовок) ложь
    $значение(значение) «»
    $команда(команда)
      функция (поле событие) пусто
  $внутренний := объект внутренний-поля-выбора%
    получатель-событий этот
    label $заголовок
    choices $элементы
    init-value $значение
    callback
      функция (элемент событие)
        $команда
          объект-адины элемент
          событие-управления-адины событие
    #,@внутренняя-инициализация-элемента-управления
  #,@методы-элемента-управления
  значение = функция-выбора
    () $внутренний{get-value}
    (новое-значение) $внутренний{set-value новое-значение}
  добавить подпись = $внутренний{append подпись}
  меню() =
    объект всплывающее-меню% внутренний($внутренний{get-menu})
  при-всплытии событие = пусто
