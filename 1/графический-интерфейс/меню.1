#!1
используется класс
  графический-интерфейс/объект
  графический-интерфейс/событие
  с-префиксом rkt: racket/gui/base

предоставлять строка-меню% меню% всплывающее-меню% пункт-меню% \
  пункт-меню-с-отметкой% разделитель-меню% \
  пункт-меню<%> пункт-меню-с-заголовком<%> пункт-меню-выбираемый<%> \
  пункт-меню-адины стандартный-префикс-клавиши-меню

пункт-меню<%> = интерфейс () удалить родитель удалён? восстановить

пункт-меню-с-заголовком<%> = интерфейс (пункт-меню<%>) включить заголовок \
  строка-помощи включён?

пункт-меню-выбираемый<%> = интерфейс (пункт-меню-с-заголовком<%>) \
  клавиша префикс-клавиши

префикс-клавиши-элемент->английский термин =
  выбор термин
    (альт) 'alt
    (команда) 'cmd
    (мета) 'meta
    (контроль) 'ctl
    (шифт) 'shift
    (опция) 'option
    иначе термин

префикс-клавиши-элемент->русский термин =
  выбор термин
    (alt) 'альт
    (cmd) 'команда
    (meta) 'мета
    (ctl) 'контроль
    (shift) 'шифт
    (option) 'опция
    иначе термин

префикс-клавиши->английский список =
  отобразить префикс-клавиши-элемент->английский список

префикс-клавиши->русский список =
  отобразить префикс-клавиши-элемент->русский список

стандартный-префикс-клавиши-меню() =
  префикс-клавиши->русский rkt:get-default-shortcut-prefix()

при-компиляции
  методы-пункта-меню = '
    родитель() =
      пункт-меню-адины $внутренний{get-parent}
    удалить() = $внутренний{delete}
    удалён?() = $внутренний{is-deleted?}
    восстановить() = $внутренний{restore}
  методы-пункта-меню-с-заголовком = '
    заголовок = функция-выбора
      () $внутренний{get-label}
      (новое-значение) $внутренний{set-label новое-значение}
    включить включён? = $внутренний{enable включён?}
    включён?() = $внутренний{is-enabled?}
    строка-помощи = функция-выбора
      () $внутренний{get-help-string}
      (новое-значение) $внутренний{set-help-string новое-значение}
  методы-пункта-меню-выбираемого = '
    клавиша = функция-выбора
      () $внутренний{get-shortcut}
      (значение) $внутренний{set-shortcut значение}
    префикс-клавиши = функция-выбора
      ()
        префикс-клавиши->русский $внутренний{get-shortcut-prefix}
      (значение)
        $внутренний{set-shortcut-prefix префикс-клавиши->английский(значение)}
  методы-контейнера-меню = '
    элементы() =
      отобразить пункт-меню-адины $внутренний{get-items}
    при-запросе() = $внутренний{on-demand}
  методы-отметки-пункта-меню = '
    отметить значение = $внутренний{check значение}
    отмечен?() = $внутренний{is-checked?}

внутренний-строки-меню% = сформировать-код $ #` класс* rkt:menu-bar% \
  (внутренний-адины<%>)
  #,@начало-внутреннего

строка-меню% = сформировать-код $ #` класс объект-графического-интерфейса%
  #,@начало
  методы #,@(отобразить имя-метода методы-контейнера-меню)
  инициализировать
    $$внутренний(внутренний) ложь
    $родитель(родитель) ложь
    $при-запросе(при-запросе)
      функция (строка) пусто
  $внутренний := $$внутренний
  если не $внутренний тогда
    $внутренний := объект внутренний-строки-меню%
      получатель-событий этот
      parent $родитель{внутренний}
      demand-callback
        функция (строка)
          $при-запросе пункт-меню-адины(строка)
  #,@методы-контейнера-меню

внутренний-меню% = сформировать-код $ #` класс* rkt:menu% (внутренний-адины<%>)
  #,@начало-внутреннего

меню% = сформировать-код $ #` класс* объект-графического-интерфейса% \
  (пункт-меню-с-заголовком<%>)
  #,@начало
  методы #,@(отобразить имя-метода
    $ методы-пункта-меню ++ методы-пункта-меню-с-заголовком
      ++ методы-контейнера-меню)
  инициализировать
    $$внутренний(внутренний) ложь
    $родитель(родитель) ложь
    $заголовок(заголовок) ложь
    $строка-помощи(строка-помощи) ложь
    $при-запросе(при-запросе)
      функция (меню) пусто
  $внутренний := $$внутренний
  если не $внутренний тогда
    $внутренний := объект внутренний-меню%
      получатель-событий этот
      parent $родитель{внутренний}
      label $заголовок
      help-string $строка-помощи
      demand-callback
        функция (меню)
          $при-запросе пункт-меню-адины(меню)
  #,@методы-пункта-меню
  #,@методы-пункта-меню-с-заголовком
  #,@методы-контейнера-меню

внутренний-всплывающего-меню% = сформировать-код
  #` класс* rkt:popup-menu% (внутренний-адины<%>)
    #,@начало-внутреннего

всплывающее-меню% = сформировать-код $ #` класс объект-графического-интерфейса%
  #,@начало
  методы #,@(отобразить имя-метода методы-контейнера-меню)
  инициализировать
    $$внутренний(внутренний) ложь
    $заголовок(заголовок) «»
    $при-запросе(при-запросе)
      функция (меню) пусто
  $внутренний := $$внутренний
  если не $внутренний тогда
    $внутренний := объект внутренний-всплывающего-меню%
      получатель-событий этот
      title $заголовок
      demand-callback
        функция (меню)
          $при-запросе пункт-меню-адины(меню)
  #,@методы-контейнера-меню

внутренний-пункт-меню% = сформировать-код
  #` класс* rkt:menu-item% (внутренний-адины<%>)
    #,@начало-внутреннего

пункт-меню% = сформировать-код $ #` класс* объект-графического-интерфейса% \
  (пункт-меню-выбираемый<%>)
  #,@начало
  методы #,@(отобразить имя-метода
    $ методы-пункта-меню ++ методы-пункта-меню-с-заголовком
      ++ методы-пункта-меню-выбираемого)
  инициализировать
    $$внутренний(внутренний) ложь
    $родитель(родитель) ложь
    $заголовок(заголовок) ложь
    $действие(действие)
      функция (пункт событие) пусто
    $клавиша(клавиша) ложь
    $строка-помощи(строка-помощи) ложь
    $префикс-клавиши(префикс-клавиши)
      стандартный-префикс-клавиши-меню()
    $при-запросе(при-запросе)
      функция (пункт) пусто
  $внутренний := $$внутренний
  если не $внутренний тогда
    $внутренний := объект внутренний-пункт-меню%
      получатель-событий этот
      parent $родитель{внутренний}
      label $заголовок
      callback
        функция (пункт событие)
          $действие
            пункт-меню-адины пункт
            событие-управления-адины событие
      shortcut $клавиша
      help-string $строка-помощи
      demand-callback
        функция (пункт)
          $при-запросе пункт-меню-адины(пункт)
      shortcut-prefix префикс-клавиши->английский($префикс-клавиши)
  #,@методы-пункта-меню
  #,@методы-пункта-меню-с-заголовком
  #,@методы-пункта-меню-выбираемого

внутренний-пункт-меню-с-отметкой% = сформировать-код
  #` класс* rkt:checkable-menu-item% (внутренний-адины<%>)
    #,@начало-внутреннего

пункт-меню-с-отметкой% = сформировать-код
  #` класс* объект-графического-интерфейса% (пункт-меню-выбираемый<%>)
    #,@начало
    методы #,@(отобразить имя-метода
      $ методы-пункта-меню ++ методы-пункта-меню-с-заголовком
        ++ методы-пункта-меню-выбираемого ++ методы-отметки-пункта-меню)
    инициализировать
      $$внутренний(внутренний) ложь
      $родитель(родитель) ложь
      $заголовок(заголовок) ложь
      $действие(действие)
        функция (пункт событие) пусто
      $клавиша(клавиша) ложь
      $строка-помощи(строка-помощи) ложь
      $префикс-клавиши(префикс-клавиши)
        стандартный-префикс-клавиши-меню()
      $начальная-отметка(отмечен?) ложь
      $при-запросе(при-запросе)
        функция (пункт) пусто
    $внутренний := $$внутренний
    если не $внутренний тогда
      $внутренний := объект внутренний-пункт-меню-с-отметкой%
        получатель-событий этот
        parent $родитель{внутренний}
        label $заголовок
        callback
          функция (пункт событие)
            $действие
              пункт-меню-адины пункт
              событие-управления-адины событие
        shortcut $клавиша
        help-string $строка-помощи
        demand-callback
          функция (пункт)
            $при-запросе пункт-меню-адины(пункт)
        checked $начальная-отметка
        shortcut-prefix префикс-клавиши->английский($префикс-клавиши)
    #,@методы-пункта-меню
    #,@методы-пункта-меню-с-заголовком
    #,@методы-пункта-меню-выбираемого
    #,@методы-отметки-пункта-меню

внутренний-разделитель-меню% = сформировать-код
  #` класс* rkt:separator-menu-item% (внутренний-адины<%>)
    #,@начало-внутреннего

разделитель-меню% = сформировать-код
  #` класс* объект-графического-интерфейса% (пункт-меню<%>)
    #,@начало
    методы #,@(отобразить имя-метода методы-пункта-меню)
    инициализировать
      $$внутренний(внутренний) ложь
      $родитель(родитель) ложь
    $внутренний := $$внутренний
    если не $внутренний тогда
      $внутренний := объект внутренний-разделитель-меню%
        получатель-событий этот
        parent $родитель{внутренний}
    #,@методы-пункта-меню

пункт-меню-адины внутренний =
  внутренний &&
    если
      (объект-класса? внутренний объект-графического-интерфейса%)
        внутренний
      (объект-класса? внутренний внутренний-пункт-меню-с-отметкой%)
        поле получатель-событий внутренний
      (объект-класса? внутренний внутренний-пункт-меню%)
        поле получатель-событий внутренний
      (объект-класса? внутренний внутренний-разделитель-меню%)
        поле получатель-событий внутренний
      (объект-класса? внутренний внутренний-меню%)
        поле получатель-событий внутренний
      (объект-класса? внутренний внутренний-всплывающего-меню%)
        поле получатель-событий внутренний
      (объект-класса? внутренний внутренний-строки-меню%)
        поле получатель-событий внутренний
      (объект-класса? внутренний rkt:checkable-menu-item%)
        объект пункт-меню-с-отметкой% внутренний(внутренний)
      (объект-класса? внутренний rkt:menu-item%)
        объект пункт-меню% внутренний(внутренний)
      (объект-класса? внутренний rkt:separator-menu-item%)
        объект разделитель-меню% внутренний(внутренний)
      (объект-класса? внутренний rkt:menu%)
        объект меню% внутренний(внутренний)
      (объект-класса? внутренний rkt:popup-menu%)
        объект всплывающее-меню% внутренний(внутренний)
      (объект-класса? внутренний rkt:menu-bar%)
        объект строка-меню% внутренний(внутренний)
      иначе
        ложь
