#!1
используется класс
  графический-интерфейс/объект
  графический-интерфейс/интерфейс-картина
  рисование/холст
  с-префиксом rkt: racket/gui/base
  графический-интерфейс/событие
предоставлять поле-редактора%

стиль->английский список-терминов =
  отобразить
    функция (термин)
      выбор термин
        (без-рамки) 'no-border
        (рамка-элемента-управления) 'control-border
        (комбинированное) 'combo
        (без-горизонтальной-прокрутки) 'no-hscroll
        (без-вертикальной-прокрутки) 'no-vscroll
        (скрыть-горизонтальную-прокрутку) 'hide-hscroll
        (скрыть-вертикальную-прокрутку) 'hide-vscroll
        (авто-горизонтальная-прокрутка) 'auto-hscroll
        (авто-вертикальная-прокрутка) 'auto-vscroll
        (угол-изменения-размера) 'resize-corner
        (без-фокуса) 'no-focus
        (скрытая) 'deleted
        (прозрачная) 'transparent
    список-терминов

внутренний-поля-редактора% = сформировать-код $ #` класс rkt:editor-canvas%
  #,@начало-внутреннего
  переопределить #,@(отобразить имя-метода события-картины)
  #,@события-картины

поле-редактора% = сформировать-код $ #` класс* объект-графического-интерфейса% (картина<%>)
  базовый-объект()
  методы #,@(отобразить имя-метода методы-картины)
  инициализировать
    #,@инициализация-картины(0)
    $заголовок(заголовок) ложь
    $стиль(стиль) '()
    $редактор(редактор) ложь
  $внутренний = объект внутренний-поля-редактора%
    получатель-событий этот
    label $заголовок
    style стиль->английский($стиль)
    editor
      внутренний-объект $редактор
    #,@внутренняя-инициализация-картины
  #,@методы-картины