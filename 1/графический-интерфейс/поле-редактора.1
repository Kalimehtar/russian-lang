#!1
используется класс
  графический-интерфейс/объект
  графический-интерфейс/интерфейс-картина
  рисование/холст
  с-префиксом rkt: racket/gui/base
  графический-интерфейс/событие
предоставлять поле-редактора%

внутренний-поля-редактора% = сформировать-код $ #` класс rkt:editor-canvas%
  #,@начало-внутреннего
  переопределить #,@(отобразить имя-метода события-картины)
  #,@события-картины

поле-редактора% = сформировать-код $ #` класс* объект-графического-интерфейса% (картина<%>)
  базовый-объект()
  методы #,@(отобразить имя-метода методы-картины)
  инициализировать
    #,@инициализация-картины(0)
    $заголовок(заголовок) ложь
    $стиль(стиль) '()
    $редактор(редактор) ложь
  $внутренний = объект внутренний-поля-редактора%
    получатель-событий этот
    label $заголовок
    style $стиль
    editor
      внутренний-объект $редактор
    #,@внутренняя-инициализация-картины
  #,@методы-картины