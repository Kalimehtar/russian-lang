#!1
используется класс
  графический-интерфейс/объект
  с-префиксом rkt: racket/gui/base
предоставлять событие% событие-мыши-адины событие-клавиши-адины событие-управления-адины

при-компиляции
  методы-события = '
    $ время = функция-выбора
      () $внутренний{get-time-stamp}
      (значение) $внутренний{set-time-stamp значение}

событие% = сформировать-код $ #` класс объект-графического-интерфейса%
  #,@начало
  методы #,@(отобразить имя-метода методы-события)
  инициализировать
    $время(время) 0
  если не $внутренний тогда
    $внутренний := объект rkt:event%
      time-stamp $время
  #,@методы-события

тип->английский тип =
  выбор тип
    (вход) 'enter
    (выход) 'leave
    (левая-нажата) 'left-down
    (левая-отпущена) 'left-up
    (средняя-нажата) 'middle-down
    (средняя-отпущена) 'middle-up
    (правая-нажата) 'right-down
    (правая-отпущена) 'right-up
    (движение) 'motion

тип->русский тип =
  выбор тип
    (enter) 'вход
    (leave) 'выход
    (left-down) 'левая-нажата
    (left-up) 'левая-отпущена
    (middle-down) 'средняя-нажата
    (middle-up) 'средняя-отпущена
    (right-down) 'правая-нажата
    (right-up) 'правая-отпущена
    (motion) 'движение

тип-управления->английский тип =
  выбор тип
    (кнопка) 'button
    (флажок) 'check-box
    (выбор) 'choice
    (список) 'list-box
    (двойной-щелчок-по-списку) 'list-box-dclick
    (текстовое-поле) 'text-field
    (ввод-в-текстовом-поле) 'text-field-enter
    (меню) 'menu
    (ползунок) 'slider
    (переключатель) 'radio-box
    (меню-выбрано) 'menu-popdown
    (меню-не-выбрано) 'menu-popdown-none
    (вкладка) 'tab-panel
    (колонка-списка) 'list-box-column

тип-управления->русский тип =
  выбор тип
    (button) 'кнопка
    (check-box) 'флажок
    (choice) 'выбор
    (list-box) 'список
    (list-box-dclick) 'двойной-щелчок-по-списку
    (text-field) 'текстовое-поле
    (text-field-enter) 'ввод-в-текстовом-поле
    (menu) 'меню
    (slider) 'ползунок
    (radio-box) 'переключатель
    (menu-popdown) 'меню-выбрано
    (menu-popdown-none) 'меню-не-выбрано
    (tab-panel) 'вкладка
    (list-box-column) 'колонка-списка

кнопка->английский кнопка =
  выбор кнопка
    (левая) 'left
    (правая) 'right
    (средняя) 'middle
    (любая) 'any

событие-мыши% = класс событие%
  унаследованные-поля $внутренний
  базовый-объект
    внутренний истина
  инициализировать
    $тип(тип) 'вход
    $время(время) 0
    $$внутренний(внутренний) ложь
  $внутренний := $$внутренний
  если не $внутренний тогда
    $внутренний := объект rkt:mouse-event%
      event-type тип->английский($тип)
      time-stamp $время
  методы тип нажата-кнопка? отпущена-кнопка? лево верх
  тип = функция-выбора
    ()
      тип->русский $внутренний{get-event-type}
    (значение) $внутренний{set-event-type тип->английский(значение)}
  нажата-кнопка? кнопка =
    $внутренний{button-down? кнопка->английский(кнопка)}
  отпущена-кнопка? кнопка =
    $внутренний{button-up? кнопка->английский(кнопка)}
  лево() = $внутренний{get-x}
  верх() = $внутренний{get-y}

событие-клавиши% = класс событие%
  унаследованные-поля $внутренний
  базовый-объект
    внутренний истина
  инициализировать
    $$внутренний(внутренний) ложь
  $внутренний := $$внутренний
  если не $внутренний тогда
    $внутренний := объект rkt:key-event%
  методы клавиша
  клавиша() = $внутренний{get-ket-code}

событие-управления% = класс событие%
  унаследованные-поля $внутренний
  базовый-объект
    внутренний истина
  инициализировать
    $$внутренний(внутренний) ложь
  $внутренний := $$внутренний
  если не $внутренний тогда
    $внутренний := объект rkt:control-event%
  методы тип
  тип = функция-выбора
    ()
      тип-управления->русский $внутренний{get-event-type}
    (значение) $внутренний{set-event-type тип-управления->английский(значение)}

событие-мыши-адины событие =
  объект событие-мыши%
    внутренний событие

событие-клавиши-адины событие =
  объект событие-клавиши%
    внутренний событие

событие-управления-адины событие =
  объект событие-управления%
    внутренний событие