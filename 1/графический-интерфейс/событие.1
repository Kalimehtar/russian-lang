#!1
используется класс
  графический-интерфейс/объект
  с-префиксом rkt: racket/gui/base
предоставлять событие% событие-мыши-адины событие-клавиши-адины

при-компиляции
  методы-события = '
    $ время = функция-выбора
      () $внутренний{get-time-stamp}
      (значение) $внутренний{set-time-stamp значение}

событие% = сформировать-код $ #` класс объект-графического-интерфейса%
  #,@начало
  методы #,@(отобразить имя-метода методы-события)
  инициализировать
    $время(время) 0
  если не $внутренний тогда
    $внутренний := объект rkt:event%
      time-stamp $время
  #,@методы-события

тип->английский тип =
  выбор тип
    (вход) 'enter
    (выход) 'leave
    (левая-нажата) 'left-down
    (левая-отпущена) 'left-up
    (средняя-нажата) 'middle-down
    (средняя-отпущена) 'middle-up
    (правая-нажата) 'right-down
    (правая-отпущена) 'right-up
    (движение) 'motion

тип->русский тип =
  выбор тип
    (enter) 'вход
    (leave) 'выход
    (left-down) 'левая-нажата
    (left-up) 'левая-отпущена
    (middle-down) 'средняя-нажата
    (middle-up) 'средняя-отпущена
    (right-down) 'правая-нажата
    (right-up) 'правая-отпущена
    (motion) 'движение

кнопка->английский кнопка =
  выбор кнопка
    (левая) 'left
    (правая) 'right
    (средняя) 'middle
    (любая) 'any

событие-мыши% = класс событие%
  унаследованные-поля $внутренний
  базовый-объект
    внутренний истина
  инициализировать
    $тип(тип) 'вход
    $время(время) 0
    $$внутренний(внутренний) ложь
  $внутренний := $$внутренний
  если не $внутренний тогда
    $внутренний := объект rkt:mouse-event%
      event-type тип->английский($тип)
      time-stamp $время
  методы тип нажата-кнопка? отпущена-кнопка? лево верх
  тип() =
    функция-выбора
      ()
        тип->русский $внутренний{get-event-type}
      (значение) $внутренний{set-event-type тип->английский(значение)}
  нажата-кнопка? кнопка =
    $внутренний{button-down? кнопка->английский(кнопка)}
  отпущена-кнопка? кнопка =
    $внутренний{button-up? кнопка->английский(кнопка)}
  лево() = $внутренний{get-x}
  верх() = $внутренний{get-y}

событие-клавиши% = класс событие%
  унаследованные-поля $внутренний
  базовый-объект
    внутренний истина
  инициализировать
    $$внутренний(внутренний) ложь
  $внутренний := $$внутренний
  если не $внутренний тогда
    $внутренний := объект rkt:key-event%
  методы клавиша
  клавиша() = $внутренний{get-ket-code}

событие-мыши-адины событие =
  объект событие-мыши%
    внутренний событие

событие-клавиши-адины событие =
  объект событие-клавиши%
    внутренний событие
