#!1
используется класс графический-интерфейс/объект графический-интерфейс/интерфейс-редактор
  графический-интерфейс/набор-команд
  графический-интерфейс/событие
  графический-интерфейс/стиль
  рисование/холст
  рисование/изображение
  с-префиксом rkt: racket/gui/base
  с-префиксом rkt-base: racket/base
предоставлять текст% для-каждого-куска кусок% кусок-со-строкой% кусок-с-изображением%
  кусок-с-редактором%

направление->английский термин =
  выбор термин
    (перед-или-пусто) 'before-or-none
    (перед) 'before
    (после) 'after
    (после-или-пусто) 'after-or-none

конец-get-text->английский конец =
  если конец === 'конец-файла тогда 'eof иначе конец

конец-set-position->английский конец =
  если конец === 'начало тогда 'same иначе конец

тип-выделения->английский тип =
  выбор тип
    (по-умолчанию) 'default
    (локально) 'local
    иначе тип

при-компиляции
  дополняемые-события-текста = дополняемые-события-редактора ++ '
    after-insert начало длина =
      получатель-событий{после-вставки начало длина}
    after-merge-snips позиция =
      получатель-событий{после-объединения-кусков позиция}
    can-change-style? начало длина =
      получатель-событий{можно-менять-стиль? начало длина}
  события-текста = события-редактора
  методы-текста = методы-редактора ++ '
    вставить = функция-выбора
      (элемент) $внутренний{insert внутренний-объект(элемент)}
      (элемент начало) $внутренний{insert внутренний-объект(элемент) начало}
      (элемент начало конец) $внутренний{insert внутренний-объект(элемент) начало конец}
      (элемент начало конец прокрутка)
        $внутренний{insert внутренний-объект(элемент) начало конец прокрутка}
      (элемент начало конец прокрутка объединять)
        $внутренний{insert элемент начало конец прокрутка объединять}
      (количество элемент начало конец прокрутка объединять)
        $внутренний{insert количество элемент начало конец прокрутка объединять}
    только-просмотр значение = $внутренний{lock значение}
    очистить() = $внутренний{erase}
    найти-позицию лево верх  = $внутренний{find-position лево верх}
    найти-кусок позиция направление =
      кусок-адины $внутренний{find-snip позиция направление->английский(направление)}
    изменить-стиль
      стиль-или-отклонение ложь
      начало 'start
      конец 'end
      считать-изменением истина
      =
      $внутренний{change-style внутренний-объект(стиль-или-отклонение)
                               начало конец считать-изменением}
    данные-куска = функция-выбора
      (кусок) $внутренний{get-snip-data внутренний-объект(кусок)}
      (кусок данные) $внутренний{set-snip-data внутренний-объект(кусок) данные}
    обработчик-щелчка начало конец функция отметка(ложь) при-нажатии?(ложь) =
      $внутренний{set-clickback	начало конец функция отметка при-нажатии?}
    последняя-позиция() = $внутренний{last-position}
    начало-выделения() = $внутренний{get-start-position}
    конец-выделения() = $внутренний{get-end-position}
    текст
      начало 0
      конец 'конец-файла
      сплющить? ложь
      принудительный-перенос? ложь
      =
      $внутренний{get-text начало конец-get-text->английский(конец)
                               сплющить? принудительный-перенос?}
    установить-выделение
      начало
      конец 'начало
      в-конце-строки? ложь
      прокрутить? истина
      тип-выделения 'по-умолчанию
      =
      $внутренний{set-position начало конец-set-position->английский(конец)
                               в-конце-строки? прокрутить?
                               тип-выделения->английский(тип-выделения)}
    конец-абзаца абзац видимый?(истина) =
      $внутренний{paragraph-end-position абзац видимый?}
    прокрутить-к-позиции позиция = $внутренний{scroll-to-position позиция}
    позиция-куска кусок = $внутренний{get-snip-position внутренний-объект(кусок)}
    -- события текст%
    после-вставки начало длина = пусто
    после-объединения-кусков позиция = пусто
    можно-менять-стиль? начало длина = истина

внутренний-текста% = сформировать-код $ #` класс rkt:text%
  #,@начало-внутреннего
  дополнить #,@(отобразить имя-метода дополняемые-события-текста)
  переопределить #,@(отобразить имя-метода события-текста)
  #,@дополняемые-события-текста
  #,@события-текста

текст% = сформировать-код $ #` класс* объект-графического-интерфейса% (редактор<%>)
  #,@начало
  методы #,@(отобразить имя-метода методы-текста)
  инициализировать
    $$внутренний(внутренний) ложь
    $межстрочный-промежуток(межстрочный-промежуток) 1.0
    $автоматический-перенос(автоматический-перенос) ложь
  $внутренний := $$внутренний || объект внутренний-текста%
    получатель-событий этот
    line-spacing $межстрочный-промежуток
    auto-wrap $автоматический-перенос
  #,@методы-текста

для-каждого-куска текст функция =
  рекурсивно
    обработать-куски
      текущий-кусок текст{первый-кусок}
    если текущий-кусок тогда
      функция текущий-кусок
      обработать-куски текущий-кусок{следующий}

параметры->английский список-терминов =
  отобразить
    функция (термин)
      выбор термин
        (текст) 'is-text
        (можно-объединять) 'can-append
        (невидимый) 'invisible
        (перенос-после) 'hard-newline
        (перенос) 'newline
        (обрабатывает-события) 'handles-events
        (обрабатывает-все-события-мыши) 'handles-all-mouse-events
        (обрабатывает-события-между) 'handles-between-events
        (ширина-зависит-от-положения-левого-края) 'width-depends-on-x
        (высота-зависит-от-положения-левого-края) 'height-depends-on-x
        (ширина-зависит-от-положения-верхнего-края) 'width-depends-on-y
        (высота-зависит-от-положения-верхнего-края) 'height-depends-on-y
        (использует-путь-редактора) 'uses-editor-path
    список-терминов

параметры->русский список-терминов =
  отобразить
    функция (термин)
      выбор термин
        (is-text) 'текст
        (can-append) 'можно-объединять
        (invisible) 'невидимый
        (hard-newline) 'перенос-после
        (newline) 'перенос
        (handles-events) 'обрабатывает-события
        (handles-all-mouse-events) 'обрабатывает-все-события-мыши
        (handles-between-events) 'обрабатывает-события-между
        (width-depends-on-x) 'ширина-зависит-от-положения-левого-края
        (height-depends-on-x) 'высота-зависит-от-положения-левого-края
        (width-depends-on-y) 'ширина-зависит-от-положения-верхнего-края
        (height-depends-on-y) 'высота-зависит-от-положения-верхнего-края
        (uses-editor-path) 'использует-путь-редактора
    список-терминов

при-компиляции
  события-куска = '
    on-char холст лево верх лево-редактора верх-редактора событие =
      базовый on-char холст лево верх лево-редактора верх-редактора событие
      получатель-событий{при-получении-клавиши холст-адины(холст)
                                               лево верх лево-редактора верх-редактора
                                               событие-клавиши-адины(событие)}
    on-event холст лево верх лево-редактора верх-редактора событие =
      базовый on-event холст лево верх лево-редактора верх-редактора событие
      получатель-событий{при-получении-события холст-адины(холст)
                                               лево верх лево-редактора верх-редактора
                                               событие-мыши-адины(событие)}
    resize ширина высота =
      если не получатель-событий{изменён-размер ширина высота} тогда
        базовый resize ширина высота
  методы-куска = '
    следующий() =
      кусок-адины $внутренний{next}
    предыдущий() =
      кусок-адины $внутренний{previous}
    текст смещение количество = $внутренний{get-text смещение количество}
    скопировать() = $внутренний{copy}
    количество = функция-выбора
      () $внутренний{get-count}
      (новое-значение) $внутренний{set-count новое-значение}
    параметры = функция-выбора
      () параметры->русский($внутренний{get-flags})
      (новое-значение) $внутренний{set-flags параметры->английский(новое-значение)}
    стиль = функция-выбора
      () стиль-адины($внутренний{get-style})
      (новое-значение) $внутренний{set-style новое-значение{внутренний}}
    -- события
    при-получении-клавиши холст лево верх лево-редактора верх-редактора событие = пусто
    при-получении-события холст лево верх лево-редактора верх-редактора событие = пусто
    изменён-размер ширина высота = ложь

внутренний-куска% = сформировать-код $ #` класс rkt:snip%
  #,@начало-внутреннего
  переопределить #,@(отобразить имя-метода события-куска)
  #,@события-куска

кусок% = сформировать-код $ #` класс объект-графического-интерфейса%
  #,@начало
  методы #,@(отобразить имя-метода методы-куска)
  если не $внутренний тогда
    $внутренний := объект внутренний-куска%
      получатель-событий этот
  #,@методы-куска

внутренний-куска-со-строкой% = сформировать-код $ #` класс rkt:string-snip%
  инициализированные-поля получатель-событий
  инициализировать содержимое
  переопределить #,@(отобразить имя-метода события-куска)
  создать-базовый-объект содержимое
  #,@события-куска

кусок-со-строкой% = класс кусок%
  унаследованные-поля $внутренний
  базовый-объект
    внутренний истина
  инициализировать
    $$внутренний(внутренний) ложь
    $строка-или-размер(содержимое) 0
  $внутренний := $$внутренний
  если не $внутренний тогда
    $внутренний := объект внутренний-куска-со-строкой%
      получатель-событий этот
      содержимое $строка-или-размер

внутренний-куска-с-изображением% = сформировать-код $ #` класс rkt:image-snip%
  инициализированные-поля получатель-событий
  инициализировать содержимое
  переопределить #,@(отобразить имя-метода события-куска)
  создать-базовый-объект содержимое
  #,@события-куска

кусок-с-изображением% = класс кусок%
  унаследованные-поля $внутренний
  методы изображение
  базовый-объект
    внутренний истина
  инициализировать
    $$внутренний(внутренний) ложь
    $содержимое(содержимое) ложь
  $внутренний := $$внутренний
  если не $внутренний тогда
    $внутренний := объект внутренний-куска-с-изображением%
      получатель-событий этот
      содержимое
        внутренний-объект $содержимое
  изображение = функция-выбора
    ()
      объект изображение%
        внутренний $внутренний{get-bitmap}
    (значение) $внутренний{set-bitmap внутренний-объект(значение)}

внутренний-куска-с-редактором% = сформировать-код $ #` класс rkt:editor-snip%
  #,@начало-внутреннего
  переопределить #,@(отобразить имя-метода события-куска)
  #,@события-куска

кусок-с-редактором% = класс кусок%
  унаследованные-поля $внутренний
  методы редактор максимальная-ширина минимальная-ширина максимальная-высота минимальная-высота
  базовый-объект
    внутренний истина
  инициализировать
    $$внутренний(внутренний) ложь
    $редактор(редактор) ложь
    $есть-граница(есть-граница) истина
  $внутренний := $$внутренний
  если не $внутренний тогда
    $внутренний := объект внутренний-куска-с-редактором%
      получатель-событий этот
      editor
        внутренний-объект $редактор
      with-border? $есть-граница
  максимальная-ширина = функция-выбора
    () $внутренний{get-max-width}
    (новое-значение)
      $внутренний{set-max-width новое-значение}
      редактор(){максимальная-ширина новое-значение}
    (новое-значение редактор?)
      $внутренний{set-max-width новое-значение}
      если редактор? тогда
        редактор(){максимальная-ширина новое-значение}
  минимальная-ширина = функция-выбора
    () $внутренний{get-min-width}
    (новое-значение)
      $внутренний{set-min-width новое-значение}
      редактор(){минимальная-ширина новое-значение}
    (новое-значение редактор?)
      $внутренний{set-min-width новое-значение}
      если редактор? тогда
        редактор(){минимальная-ширина новое-значение}
  максимальная-высота = функция-выбора
    () $внутренний{get-max-height}
    (новое-значение)
      $внутренний{set-max-height новое-значение}
      редактор(){максимальная-высота новое-значение}
    (новое-значение редактор?)
      $внутренний{set-max-height новое-значение}
      если редактор? тогда
        редактор(){максимальная-высота новое-значение}
  минимальная-высота = функция-выбора
    () $внутренний{get-min-height}
    (новое-значение)
      $внутренний{set-min-height новое-значение}
      редактор(){минимальная-высота новое-значение}
    (новое-значение редактор?)
      $внутренний{set-min-height новое-значение}
      если редактор? тогда
        редактор(){минимальная-высота новое-значение}
  редактор() =
    внутренний =  $внутренний{get-editor}
    внутренний &&
      если
        (объект-класса? внутренний внутренний-текста%)
          объект-адины внутренний
        иначе
          объект текст% внутренний(внутренний)

кусок-адины внутренний =
  внутренний &&
    если
      (объект-класса? внутренний кусок%) внутренний
      (объект-класса? внутренний внутренний-куска-с-редактором%)
        поле получатель-событий внутренний
      (объект-класса? внутренний внутренний-куска-с-изображением%)
        поле получатель-событий внутренний
      (объект-класса? внутренний внутренний-куска-со-строкой%)
        поле получатель-событий внутренний
      (объект-класса? внутренний внутренний-куска%)
        поле получатель-событий внутренний
      (объект-класса? внутренний rkt:string-snip%)
        объект кусок-со-строкой% внутренний(внутренний)
      (объект-класса? внутренний rkt:image-snip%)
        объект кусок-с-изображением% внутренний(внутренний)
      (объект-класса? внутренний rkt:editor-snip%)
        объект кусок-с-редактором% внутренний(внутренний)
      иначе
        объект кусок% внутренний(внутренний)
