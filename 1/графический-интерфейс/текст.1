#!1
используется класс графический-интерфейс/объект графический-интерфейс/интерфейс-редактор
  графический-интерфейс/набор-команд
  графический-интерфейс/событие
  графический-интерфейс/стиль
  графический-интерфейс/реализация/термины-текста
  графический-интерфейс/реализация/термины-куска
  графический-интерфейс/реализация/методы-текста
  графический-интерфейс/реализация/методы-куска
  рисование/холст
  рисование/изображение
  с-префиксом rkt: racket/gui/base
  с-префиксом rkt-base: racket/base
предоставлять текст% для-каждого-куска кусок% кусок-со-строкой% \
  кусок-с-изображением% кусок-с-редактором%

обработчик-щелчка-адины обработчик =
  функция (текст начало конец)
    обработчик объект-адины(текст) начало конец

внутренний-текста% = сформировать-код $ #` класс* rkt:text% (внутренний-адины<%>)
  #,@начало-внутреннего
  дополнить #,@(отобразить имя-метода дополняемые-события-текста)
  переопределить #,@(отобразить имя-метода события-текста)
  #,@дополняемые-события-текста
  #,@события-текста

текст% = сформировать-код $ #` класс* объект-графического-интерфейса% (редактор<%>)
  #,@начало
  методы #,@(отобразить имя-метода методы-текста)
  инициализировать
    $$внутренний(внутренний) ложь
    $межстрочный-промежуток(межстрочный-промежуток) 1.0
    $автоматический-перенос(автоматический-перенос) ложь
  $внутренний := $$внутренний || объект внутренний-текста%
    получатель-событий этот
    line-spacing $межстрочный-промежуток
    auto-wrap $автоматический-перенос
  #,@методы-текста

для-каждого-куска текст функция =
  рекурсивно
    обработать-куски
      текущий-кусок текст{первый-кусок}
    если текущий-кусок тогда
      функция текущий-кусок
      обработать-куски текущий-кусок{следующий}

внутренний-куска% = сформировать-код $ #` класс* rkt:snip% (внутренний-адины<%>)
  #,@начало-внутреннего
  переопределить #,@(отобразить имя-метода события-куска)
  методы #,@(отобразить имя-метода дополнение-внутреннего-куска)
  #,@события-куска
  #,@дополнение-внутреннего-куска

кусок% = сформировать-код $ #` класс объект-графического-интерфейса%
  #,@начало
  методы #,@(отобразить имя-метода методы-куска)
  если не $внутренний тогда
    $внутренний := объект внутренний-куска%
      получатель-событий этот
  #,@методы-куска

внутренний-куска-со-строкой% = сформировать-код $ #` класс rkt:string-snip%
  инициализированные-поля получатель-событий
  инициализировать содержимое
  переопределить #,@(отобразить имя-метода события-куска)
  методы #,@(отобразить имя-метода дополнение-внутреннего-куска)
  создать-базовый-объект содержимое
  #,@события-куска
  #,@дополнение-внутреннего-куска

кусок-со-строкой% = класс кусок%
  унаследованные-поля $внутренний
  базовый-объект
    внутренний истина
  инициализировать
    $$внутренний(внутренний) ложь
    $строка-или-размер(содержимое) 0
  $внутренний := $$внутренний
  если не $внутренний тогда
    $внутренний := объект внутренний-куска-со-строкой%
      получатель-событий этот
      содержимое $строка-или-размер

внутренний-куска-с-изображением% = сформировать-код $ #` класс rkt:image-snip%
  инициализированные-поля получатель-событий
  инициализировать содержимое
  переопределить #,@(отобразить имя-метода события-куска)
  методы #,@(отобразить имя-метода дополнение-внутреннего-куска)
  создать-базовый-объект содержимое
  #,@события-куска
  #,@дополнение-внутреннего-куска

кусок-с-изображением% = класс кусок%
  унаследованные-поля $внутренний
  методы изображение
  базовый-объект
    внутренний истина
  инициализировать
    $$внутренний(внутренний) ложь
    $содержимое(содержимое) ложь
  $внутренний := $$внутренний
  если не $внутренний тогда
    $внутренний := объект внутренний-куска-с-изображением%
      получатель-событий этот
      содержимое
        внутренний-объект $содержимое
  изображение = функция-выбора
    ()
      объект изображение%
        внутренний $внутренний{get-bitmap}
    (значение) $внутренний{set-bitmap внутренний-объект(значение)}

внутренний-куска-с-редактором% = сформировать-код $ #` класс* rkt:editor-snip% (внутренний-адины<%>)
  #,@начало-внутреннего
  переопределить #,@(отобразить имя-метода события-куска)
  методы #,@(отобразить имя-метода дополнение-внутреннего-куска)
  #,@события-куска
  #,@дополнение-внутреннего-куска

кусок-с-редактором% = класс кусок%
  унаследованные-поля $внутренний
  методы редактор максимальная-ширина минимальная-ширина максимальная-высота \
    минимальная-высота есть-граница выравнивать-по-верхней-строке \
    плотная-подгонка-текста вставки поля использовать-фон-стиля
  базовый-объект
    внутренний истина
  инициализировать
    $$внутренний(внутренний) ложь
    $редактор(редактор) ложь
    $есть-граница(есть-граница) истина
  $внутренний := $$внутренний
  если не $внутренний тогда
    $внутренний := объект внутренний-куска-с-редактором%
      получатель-событий этот
      editor
        внутренний-объект $редактор
      with-border? $есть-граница
  максимальная-ширина = функция-выбора
    () $внутренний{get-max-width}
    (новое-значение)
      $внутренний{set-max-width новое-значение}
      редактор(){максимальная-ширина новое-значение}
    (новое-значение редактор?)
      $внутренний{set-max-width новое-значение}
      если редактор? тогда
        редактор(){максимальная-ширина новое-значение}
  минимальная-ширина = функция-выбора
    () $внутренний{get-min-width}
    (новое-значение)
      $внутренний{set-min-width новое-значение}
      редактор(){минимальная-ширина новое-значение}
    (новое-значение редактор?)
      $внутренний{set-min-width новое-значение}
      если редактор? тогда
        редактор(){минимальная-ширина новое-значение}
  максимальная-высота = функция-выбора
    () $внутренний{get-max-height}
    (новое-значение)
      $внутренний{set-max-height новое-значение}
      редактор(){максимальная-высота новое-значение}
    (новое-значение редактор?)
      $внутренний{set-max-height новое-значение}
      если редактор? тогда
        редактор(){максимальная-высота новое-значение}
  минимальная-высота = функция-выбора
    () $внутренний{get-min-height}
    (новое-значение)
      $внутренний{set-min-height новое-значение}
      редактор(){минимальная-высота новое-значение}
    (новое-значение редактор?)
      $внутренний{set-min-height новое-значение}
      если редактор? тогда
        редактор(){минимальная-высота новое-значение}
  редактор = функция-выбора
    ()
      внутренний = $внутренний{get-editor}
      внутренний &&
        если
          (объект-класса? внутренний внутренний-текста%)
            объект-адины внутренний
          иначе
            объект текст% внутренний(внутренний)
    (значение)
      $внутренний{set-editor внутренний-объект(значение)}
  есть-граница = функция-выбора
    () $внутренний{border-visible?}
    (значение) $внутренний{show-border значение}
  выравнивать-по-верхней-строке = функция-выбора
    () $внутренний{get-align-top-line}
    (значение) $внутренний{set-align-top-line значение}
  плотная-подгонка-текста = функция-выбора
    () $внутренний{get-tight-text-fit}
    (значение) $внутренний{set-tight-text-fit значение}
  вставки = функция-выбора
    ()
      лево = rkt-base:box 0
      верх = rkt-base:box 0
      право = rkt-base:box 0
      низ = rkt-base:box 0
      $внутренний{get-inset лево верх право низ}
      значения
        rkt-base:unbox лево
        rkt-base:unbox верх
        rkt-base:unbox право
        rkt-base:unbox низ
    (лево верх право низ)
      $внутренний{set-inset лево верх право низ}
  поля = функция-выбора
    ()
      лево = rkt-base:box 0
      верх = rkt-base:box 0
      право = rkt-base:box 0
      низ = rkt-base:box 0
      $внутренний{get-margin лево верх право низ}
      значения
        rkt-base:unbox лево
        rkt-base:unbox верх
        rkt-base:unbox право
        rkt-base:unbox низ
    (лево верх право низ)
      $внутренний{set-margin лево верх право низ}
  использовать-фон-стиля = функция-выбора
    () $внутренний{style-background-used?}
    (значение) $внутренний{use-style-background значение}

кусок-адины внутренний =
  внутренний &&
    если
      (объект-класса? внутренний кусок%) внутренний
      (объект-класса? внутренний внутренний-куска-с-редактором%)
        поле получатель-событий внутренний
      (объект-класса? внутренний внутренний-куска-с-изображением%)
        поле получатель-событий внутренний
      (объект-класса? внутренний внутренний-куска-со-строкой%)
        поле получатель-событий внутренний
      (объект-класса? внутренний внутренний-куска%)
        поле получатель-событий внутренний
      (объект-класса? внутренний rkt:string-snip%)
        объект кусок-со-строкой% внутренний(внутренний)
      (объект-класса? внутренний rkt:image-snip%)
        объект кусок-с-изображением% внутренний(внутренний)
      (объект-класса? внутренний rkt:editor-snip%)
        объект кусок-с-редактором% внутренний(внутренний)
      иначе
        объект кусок% внутренний(внутренний)
