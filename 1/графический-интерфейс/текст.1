#!1
используется класс графический-интерфейс/объект графический-интерфейс/интерфейс-редактор
  графический-интерфейс/кусок
  графический-интерфейс/набор-команд
  графический-интерфейс/событие
  с-префиксом rkt: racket/gui/base
  с-префиксом rkt-base: racket/base
предоставлять текст% для-каждого-куска

при-компиляции
  дополняемые-события-текста = дополняемые-события-редактора ++ '
    after-insert начало длина =
      получатель-событий{после-вставки начало длина}
    after-merge-snips позиция =
      получатель-событий{после-объединения-кусков позиция}
  события-текста = события-редактора
  методы-текста = методы-редактора ++ '
    вставить = функция-выбора
      (элемент) $внутренний{insert внутренний-объект(элемент)}
      (элемент начало) $внутренний{insert внутренний-объект(элемент) начало}
      (элемент начало конец) $внутренний{insert внутренний-объект(элемент) начало конец}
      (элемент начало конец прокрутка)
        $внутренний{insert внутренний-объект(элемент) начало конец прокрутка}
      (элемент начало конец прокрутка объединять)
        $внутренний{insert элемент начало конец прокрутка объединять}
      (количество элемент начало конец прокрутка объединять)
        $внутренний{insert количество элемент начало конец прокрутка объединять}
    только-просмотр значение = $внутренний{lock значение}
    -- события текст%
    после-вставки начало длина = пусто
    после-объединения-кусков позиция = пусто

внутренний-текста% = сформировать-код $ #` класс rkt:text%
  #,@начало-внутреннего
  дополнить #,@(отобразить имя-метода дополняемые-события-текста)
  переопределить #,@(отобразить имя-метода события-текста)
  #,@дополняемые-события-текста
  #,@события-текста

текст% = сформировать-код $ #` класс* объект-графического-интерфейса% (редактор<%>)
  #,@начало
  методы #,@(отобразить имя-метода методы-текста)
  инициализировать
    $межстрочный-промежуток(межстрочный-промежуток) 1.0
    $автоматический-перенос(автоматический-перенос) ложь
  $внутренний := объект внутренний-текста%
    получатель-событий этот
    line-spacing $межстрочный-промежуток
    auto-wrap $автоматический-перенос
  #,@методы-текста

для-каждого-куска текст функция =
  рекурсивно
    обработать-куски
      текущий-кусок текст{первый-кусок}
    если текущий-кусок тогда
      функция текущий-кусок
      обработать-куски текущий-кусок{следующий}
