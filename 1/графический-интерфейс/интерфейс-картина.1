#!1
используется класс графический-интерфейс/интерфейс-подокно
предоставлять картина<%>
предоставлять-для-синтаксиса события-картины методы-картины инициализация-картины \
  внутренняя-инициализация-картины

картина<%> = интерфейс (подокно<%>) принимать-фокус-табом отрисовать-немедленно фон холст \
  минимальная-высота-холста минимальная-ширина-холста при-получении-клавиши \
  при-получении-события при-отрисовке при-входе-табом продолжить-отрисовку приостановить-отрисовку

при-компиляции
  события-картины = события-подокна ++ '
    on-char событие =
      получатель-событий{при-получении-клавиши событие} || базовый on-char событие
    on-event событие =
      получатель-событий{при-получении-события событие} || базовый on-event событие
    on-paint() =
      получатель-событий{при-отрисовке} || базовый on-paint
    on-tab-in() =
      получатель-событий{при-входе-табом} || базовый on-tab-in
  методы-картины = методы-подокна ++ '
    принимать-фокус-табом = метод-выбора($внутренний accept-tab-focus)
    отрисовать-немедленно() = $внутренний{flush}
    фон = 
      функция-выбора
        () $внутренний{get-canvas-background}
        (новое-значение) $внутренний{set-canvas-background новое-значение}
    холст() =
      $внутренний && холст-адины $внутренний{get-dc}
    минимальная-высота-холста = метод-выбора($внутренний min-client-height)
    минимальная-ширина-холста = метод-выбора($внутренний min-client-width)
    продолжить-отрисовку() = $внутренний{resume-flush}
    приостановить-отрисовку() = $внутренний{suspend-flush}
    -- события картина<%>
    при-получении-клавиши событие = ложь
    при-получении-события событие = ложь
    при-отрисовке() = ложь
    при-входе-табом() = ложь
  инициализация-картины поле(0) =
    инициализация-подокна поле
  внутренняя-инициализация-картины = внутренняя-инициализация-подокна
