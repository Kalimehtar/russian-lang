#!1
используется класс
  графический-интерфейс/объект
  графический-интерфейс/интерфейс-элемент-управления
  графический-интерфейс/шрифт
  графический-интерфейс/событие
  с-префиксом rkt: racket/gui/base

предоставлять переключатель%

стиль->английский список-терминов =
  отобразить
    функция (термин)
      выбор термин
        (вертикальный) 'vertical
        (горизонтальный) 'horizontal
        (вертикальный-заголовок) 'vertical-label
        (горизонтальный-заголовок) 'horizontal-label
        (скрытая) 'deleted
    список-терминов

при-компиляции
  методы-без-включения =
    отобрать
      м ==>
        не
          ||
            имя-метода(м) == 'включить
            имя-метода(м) == 'включено?
      методы-элемента-управления

внутренний-переключателя% = сформировать-код $ #` класс* rkt:radio-box% \
  (внутренний-адины<%>)
  #,@начало-внутреннего
  переопределить #,@(отобразить имя-метода события-элемента-управления)
  #,@события-элемента-управления

переключатель% = сформировать-код $ #` класс* объект-графического-интерфейса% \
  (элемент-управления<%>)
  #,@начало
  методы #,@(отобразить имя-метода методы-без-включения) \
    выделение количество подпись-элемента простая-подпись-элемента \
    включить включено?
  инициализировать
    $элементы(элементы)()
    #,@инициализация-элемента-управления
    $заголовок(заголовок) ложь
    $команда(команда)
      функция (переключатель событие) пусто
    $выделение(выделение) 0
  если пустой?($стиль) тогда
    $стиль := '(вертикальный)
  $внутренний := объект внутренний-переключателя%
    получатель-событий этот
    label $заголовок
    choices
      отобразить внутренний-объект $элементы
    callback
      функция (элемент событие)
        $команда
          объект-адины элемент
          событие-управления-адины событие
    selection $выделение
    #,@внутренняя-инициализация-элемента-управления
  #,@методы-без-включения
  выделение = функция-выбора
    () $внутренний{get-selection}
    (новое-значение) $внутренний{set-selection новое-значение}
  количество() = $внутренний{get-number}
  подпись-элемента индекс = $внутренний{get-item-label индекс}
  простая-подпись-элемента индекс =
    $внутренний{get-item-plain-label индекс}
  включить = функция-выбора
    (состояние) $внутренний{enable состояние}
    (индекс состояние) $внутренний{enable индекс состояние}
  включено? = функция-выбора
    () $внутренний{is-enabled?}
    (индекс) $внутренний{is-enabled? индекс}
