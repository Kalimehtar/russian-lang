#!1
используется класс
  графический-интерфейс/объект
  рисование/изображение
  с-префиксом rkt: racket/gui/base

предоставлять буфер-обмена<%> буфер-обмена

буфер-обмена<%> = интерфейс () получить-строку установить-строку получить-данные \
  получить-изображение установить-изображение тот-же-клиент? установить-клиент

при-компиляции
  методы-буфера-обмена = '
    получить-строку время(0) = $внутренний{get-clipboard-string время}
    установить-строку текст время(0) = $внутренний{set-clipboard-string текст время}
    получить-данные формат время(0) = $внутренний{get-clipboard-data формат время}
    получить-изображение время(0) =
      картинка = $внутренний{get-clipboard-bitmap время}
      &&
        картинка
        объект изображение% внутренний(картинка)
    установить-изображение изображение время(0) =
      $внутренний{set-clipboard-bitmap внутренний-объект(изображение) время}
    тот-же-клиент? клиент =
      $внутренний{same-clipboard-client? внутренний-объект(клиент)}
    установить-клиент клиент время(0) =
      $внутренний{set-clipboard-client внутренний-объект(клиент) время}

буфер-обмена% = сформировать-код $ #` класс* объект-графического-интерфейса% (буфер-обмена<%>)
  #,@начало
  методы #,@(отобразить имя-метода методы-буфера-обмена)
  #,@методы-буфера-обмена

буфер-обмена = объект буфер-обмена%
  внутренний rkt:the-clipboard
