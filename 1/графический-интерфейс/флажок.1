#!1
используется класс
  графический-интерфейс/объект
  графический-интерфейс/интерфейс-элемент-управления
  графический-интерфейс/шрифт
  с-префиксом rkt: racket/gui/base

предоставлять флажок%

внутренний-флажка% = сформировать-код $ #` класс rkt:check-box%
  #,@начало-внутреннего
  переопределить #,@(отобразить имя-метода события-элемента-управления)
  #,@события-элемента-управления

флажок% = сформировать-код $ #` класс* объект-графического-интерфейса% (элемент-управления<%>)
  #,@начало
  методы #,@(отобразить имя-метода методы-элемента-управления) значение
  инициализировать
    $заголовок(заголовок)()
    #,@инициализация-элемента-управления
    $значение(значение) ложь
    $команда(команда)
      функция (флажок событие) пусто
  $внутренний := объект внутренний-флажка%
    получатель-событий этот
    label
      внутренний-объект $заголовок
    value $значение
    callback $команда
    #,@внутренняя-инициализация-элемента-управления
  #,@методы-элемента-управления
  значение = функция-выбора
    () $внутренний{get-value}
    (новое-значение) $внутренний{set-value новое-значение}
