#!1
используется класс
  графический-интерфейс/объект
  графический-интерфейс/событие
  с-префиксом tray: 1/tray

предоставлять область-уведомлений% загрузить-иконку

иконка->английский значение =
  если
    символ? значение
      выбор значение
        (приложение app) 'app
        (ошибка err) 'err
        (вопрос quest) 'quest
        (предупреждение warning) 'warning
        (сведения inform) 'inform
        (эмблема winlogo) 'winlogo
        (пустая blank) 'blank
        иначе значение
    иначе
      значение

иконка->русский значение =
  если
    символ? значение
      выбор значение
        (app) 'приложение
        (err) 'ошибка
        (quest) 'вопрос
        (warning) 'предупреждение
        (inform) 'сведения
        (winlogo) 'эмблема
        (blank) 'пустая
        иначе значение
    иначе
      значение

загрузить-иконку путь =
  tray:make-icon путь

область-уведомлений% =
  класс объект-графического-интерфейса%
    базовый-объект()
    унаследованные-поля $внутренний
    поля
      текущая-команда ложь
    методы показать показано? заголовок иконка команда
    инициализировать
      $заголовок(заголовок) ""
      $иконка(иконка) 'сведения
      $команда(команда)
        функция (область событие) пусто
    текущая-команда := $команда
    $внутренний := объект tray:tray%
      label $заголовок
      icon иконка->английский($иконка)
      callback $ функция (отправитель событие)
        текущая-команда этот событие-мыши-адины(событие)
    показать состояние = $внутренний{show состояние}
    показано?() = $внутренний{is-shown?}
    заголовок = функция-выбора
      () $внутренний{get-label}
      (новое-значение) $внутренний{set-label новое-значение}
    иконка = функция-выбора
      ()
        иконка->русский $внутренний{get-icon}
      (новое-значение)
        английская = иконка->английский новое-значение
        $внутренний{set-icon английская}
    команда = функция-выбора
      () текущая-команда
      (новое-значение) (текущая-команда := новое-значение)
