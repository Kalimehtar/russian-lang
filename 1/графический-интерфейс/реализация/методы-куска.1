#!1
предоставлять-для-синтаксиса события-куска дополнение-внутреннего-куска методы-куска

при-компиляции
  события-куска = '
    on-char холст лево верх лево-редактора верх-редактора событие =
      базовый on-char холст лево верх лево-редактора верх-редактора событие
      получатель-событий{при-получении-клавиши холст-адины(холст)
                                               лево верх лево-редактора верх-редактора
                                               событие-клавиши-адины(событие)}
    on-event холст лево верх лево-редактора верх-редактора событие =
      базовый on-event холст лево верх лево-редактора верх-редактора событие
      получатель-событий{при-получении-события холст-адины(холст)
                                               лево верх лево-редактора верх-редактора
                                               событие-мыши-адины(событие)}
    on-goodbye-event холст лево верх лево-редактора верх-редактора событие =
      получатель-событий{при-уходе-события холст-адины(холст)
                                             лево верх лево-редактора верх-редактора
                                             событие-мыши-адины(событие)}
      базовый on-goodbye-event холст лево верх лево-редактора верх-редактора событие
    adjust-cursor холст лево верх лево-редактора верх-редактора событие =
      получатель-событий{подобрать-курсор холст-адины(холст)
                                            лево верх лево-редактора верх-редактора
                                            событие-мыши-адины(событие)}
    blink-caret холст лево верх =
      базовый blink-caret холст лево верх
      получатель-событий{мигать-кареткой холст-адины(холст) лево верх}
    own-caret владеет? =
      базовый own-caret владеет?
      получатель-событий{при-владении-кареткой владеет?}
    size-cache-invalid() =
      базовый size-cache-invalid
      получатель-событий{сбросить-кэш-размера}
    set-unmodified() =
      базовый set-unmodified
      получатель-событий{отметить-неизменённым}
    resize ширина высота =
      получатель-событий{изменить-размер ширина высота}
    draw холст лево верх лево* верх* право* низ* дx дy каретка =
      получатель-событий{нарисовать холст-адины(холст) лево верх лево* верх* право* низ*
                                     дx дy каретка-отрисовки->русский(каретка)}
    get-extent холст лево верх ширина высота спуск пробел левый-пробел правый-пробел =
      получатель-событий{протяжённость
        холст-адины(холст)
        лево
        верх
        ширина
        высота
        спуск
        пробел
        левый-пробел
        правый-пробел}
    partial-offset холст лево верх длина =
      получатель-событий{частичное-смещение холст-адины(холст) лево верх длина}
    find-scroll-step смещение =
      получатель-событий{найти-шаг-прокрутки смещение}
    get-num-scroll-steps() =
      получатель-событий{число-шагов-прокрутки}
    get-scroll-step-offset шаг =
      получатель-событий{смещение-шага-прокрутки шаг}
    split позиция первый второй =
      получатель-событий{разделить позиция первый второй}
    merge-with предыдущий =
      внутренний-объект
        получатель-событий{объединить-с кусок-адины(предыдущий)}
    write поток =
      получатель-событий{записать поток}
    equal-to? кусок равенство =
      получатель-событий{равен-куску? кусок-адины(кусок) равенство}
    other-equal-to? кусок равенство =
      получатель-событий{другой-равен? кусок-адины(кусок) равенство}
    equal-hash-code-of хэш =
      получатель-событий{хэш-равенства хэш}
    equal-secondary-hash-code-of хэш =
      получатель-событий{вторичный-хэш-равенства хэш}
  дополнение-внутреннего-куска = '
    базовый-изменить-размер ширина высота =
      базовый resize ширина высота
    базовый-нарисовать холст лево верх лево* верх* право* низ* дx дy каретка =
      базовый draw холст лево верх лево* верх* право* низ* дx дy каретка
    базовый-протяжённость холст лево верх
      ширина
      высота
      спуск
      пробел
      левый-пробел
      правый-пробел
      =
      базовый get-extent холст лево верх ширина высота спуск пробел
        левый-пробел
        правый-пробел
    базовый-частичное-смещение холст лево верх длина =
      базовый partial-offset холст лево верх длина
    базовый-найти-шаг-прокрутки смещение =
      базовый find-scroll-step смещение
    базовый-число-шагов-прокрутки() =
      базовый get-num-scroll-steps
    базовый-смещение-шага-прокрутки шаг =
      базовый get-scroll-step-offset шаг
    базовый-разделить позиция первый второй =
      базовый split позиция первый второй
    базовый-объединить-с предыдущий =
      базовый merge-with предыдущий
    базовый-записать поток =
      базовый write поток
    базовый-равен-куску? кусок равенство =
      базовый equal-to? кусок равенство
    базовый-другой-равен? кусок равенство =
      базовый other-equal-to? кусок равенство
    базовый-хэш-равенства хэш =
      базовый equal-hash-code-of хэш
    базовый-вторичный-хэш-равенства хэш =
      базовый equal-secondary-hash-code-of хэш
    базовый-подобрать-курсор холст лево верх лево-редактора верх-редактора событие =
      базовый adjust-cursor холст лево верх лево-редактора верх-редактора событие
  методы-куска = '
    следующий() =
      кусок-адины $внутренний{next}
    предыдущий() =
      кусок-адины $внутренний{previous}
    текст смещение количество = $внутренний{get-text смещение количество}
    заполнить-текст смещение количество буфер смещение-буфера =
      $внутренний{get-text! смещение количество буфер смещение-буфера}
    скопировать() =
      кусок-адины($внутренний{copy})
    количество = функция-выбора
      () $внутренний{get-count}
      (новое-значение) $внутренний{set-count новое-значение}
    параметры = функция-выбора
      () параметры->русский($внутренний{get-flags})
      (новое-значение) $внутренний{set-flags параметры->английский(новое-значение)}
    стиль = функция-выбора
      () стиль-адины($внутренний{get-style})
      (новое-значение) $внутренний{set-style новое-значение{внутренний}}
    изменить-размер ширина высота =
      $внутренний{базовый-изменить-размер ширина высота}
    подобрать-курсор холст лево верх лево-редактора верх-редактора событие =
      $внутренний{базовый-подобрать-курсор внутренний-объект(холст)
        лево верх лево-редактора верх-редактора внутренний-объект(событие)}
    нарисовать холст лево верх лево* верх* право* низ* дx дy каретка =
      $внутренний{базовый-нарисовать внутренний-объект(холст) лево верх лево* верх*
        право* низ* дx дy каретка-отрисовки->английский(каретка)}
    протяжённость холст лево верх
      ширина ложь
      высота ложь
      спуск ложь
      пробел ложь
      левый-пробел ложь
      правый-пробел ложь
      =
      $внутренний{базовый-протяжённость
        внутренний-объект(холст)
        лево
        верх
        ширина
        высота
        спуск
        пробел
        левый-пробел
        правый-пробел}
    частичное-смещение холст лево верх длина =
      $внутренний{базовый-частичное-смещение внутренний-объект(холст) лево верх длина}
    найти-шаг-прокрутки смещение =
      $внутренний{базовый-найти-шаг-прокрутки смещение}
    число-шагов-прокрутки() =
      $внутренний{базовый-число-шагов-прокрутки}
    смещение-шага-прокрутки шаг =
      $внутренний{базовый-смещение-шага-прокрутки шаг}
    разделить = функция-выбора
      (позиция)
        первый = rkt-base:box ложь
        второй = rkt-base:box ложь
        $внутренний{split позиция первый второй}
        значения
          кусок-адины rkt-base:unbox(первый)
          кусок-адины rkt-base:unbox(второй)
      (позиция первый второй)
        $внутренний{базовый-разделить позиция первый второй}
    объединить-с кусок =
      кусок-адины
        $внутренний{базовый-объединить-с внутренний-объект(кусок)}
    записать поток =
      $внутренний{базовый-записать поток}
    равен-куску? кусок равенство =
      $внутренний{базовый-равен-куску? внутренний-объект(кусок) равенство}
    другой-равен? кусок равенство =
      $внутренний{базовый-другой-равен? внутренний-объект(кусок) равенство}
    хэш-равенства хэш =
      $внутренний{базовый-хэш-равенства хэш}
    вторичный-хэш-равенства хэш =
      $внутренний{базовый-вторичный-хэш-равенства хэш}
    можно-операцию-редактирования? операция рекурсивно?(истина) =
      $внутренний{can-do-edit-operation?
        операция-редактирования->английский(операция) рекурсивно?}
    выполнить-операцию-редактирования операция
      рекурсивно? истина
      время 0
      =
      $внутренний{do-edit-operation операция-редактирования->английский(операция)
        рекурсивно? время}
    занят?() = $внутренний{is-owned?}
    освободить-от-владельца() = $внутренний{release-from-owner}
    администратор = функция-выбора
      () $внутренний{get-admin}
      (значение) $внутренний{set-admin значение}
    класс-куска = функция-выбора
      () $внутренний{get-snipclass}
      (значение) $внутренний{set-snipclass значение}
    количество-графем() = $внутренний{get-grapheme-count}
    позиция-графемы номер = $внутренний{grapheme-position номер}
    графема-позиции номер = $внутренний{position-grapheme номер}
    установить-количество-литер-и-графем литеры графемы =
      $внутренний{set-char-and-grapheme-count литеры графемы}
    установить-s-количество-литер количество =
      $внутренний{set-s-char-count количество}
    совпадает? кусок =
      $внутренний{match? внутренний-объект(кусок)}
    -- события
    при-получении-клавиши холст лево верх лево-редактора верх-редактора событие = пусто
    при-получении-события холст лево верх лево-редактора верх-редактора событие = пусто
    при-уходе-события холст лево верх лево-редактора верх-редактора событие = пусто
    мигать-кареткой холст лево верх = пусто
    при-владении-кареткой владеет? = пусто
    сбросить-кэш-размера() = пусто
    отметить-неизменённым() = пусто
