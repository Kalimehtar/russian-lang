#!1
предоставлять направление->английский конец-get-text->английский \
  конец-set-position->английский тип-выделения->английский \
  код-перемещения->английский вид-перемещения->английский \
  направление-поиска->английский начало-поиска->английский \
  удалить-начало->английский удалить-конец->английский

направление->английский термин =
  выбор термин
    (перед-или-пусто) 'before-or-none
    (перед) 'before
    (после) 'after
    (после-или-пусто) 'after-or-none

конец-get-text->английский конец =
  если конец === 'конец-файла тогда 'eof иначе конец

конец-set-position->английский конец =
  если конец === 'начало тогда 'same иначе конец

тип-выделения->английский тип =
  выбор тип
    (по-умолчанию) 'default
    (локально) 'local
    иначе тип

код-перемещения->английский код =
  выбор код
    (домой) 'home
    (в-конец) 'end
    (вправо) 'right
    (влево) 'left
    (вверх) 'up
    (вниз) 'down
    иначе код

вид-перемещения->английский вид =
  выбор вид
    (просто) 'simple
    (слово) 'word
    (страница) 'page
    (строка) 'line
    иначе вид

направление-поиска->английский направление =
  выбор направление
    (вперёд) 'forward
    (назад) 'backward
    иначе направление

начало-поиска->английский начало =
  если начало === 'начало тогда 0 иначе начало

удалить-начало->английский начало =
  если начало === 'начало тогда 'start иначе начало

удалить-конец->английский конец =
  если конец === 'назад тогда 'back иначе конец
