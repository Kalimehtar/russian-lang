#!1
используется класс графический-интерфейс/интерфейс-редактор
предоставлять-для-синтаксиса дополняемые-события-текста события-текста методы-текста

при-компиляции
  дополняемые-события-текста = дополняемые-события-редактора ++ '
    after-insert начало длина =
      получатель-событий{после-вставки начало длина}
    after-delete начало длина =
      получатель-событий{после-удаления начало длина}
    after-merge-snips позиция =
      получатель-событий{после-объединения-кусков позиция}
    after-change-style начало длина =
      получатель-событий{после-изменения-стиля начало длина}
    after-set-position() =
      получатель-событий{после-установки-позиции}
    can-change-style? начало длина =
      получатель-событий{можно-менять-стиль? начало длина}
    can-delete? начало длина =
      получатель-событий{можно-удалить? начало длина}
    can-insert? начало длина =
      получатель-событий{можно-вставить? начало длина}
    on-delete начало длина =
      получатель-событий{при-удалении начало длина}
    on-insert начало длина =
      получатель-событий{при-вставке начало длина}
    on-change-style начало длина =
      получатель-событий{при-изменении-стиля начало длина}
  события-текста = события-редактора
  методы-текста = методы-редактора ++ '
    вставить = функция-выбора
      (элемент) $внутренний{insert внутренний-объект(элемент)}
      (элемент начало) $внутренний{insert внутренний-объект(элемент) начало}
      (элемент начало конец) $внутренний{insert внутренний-объект(элемент) начало конец}
      (элемент начало конец прокрутка)
        $внутренний{insert внутренний-объект(элемент) начало конец прокрутка}
      (элемент начало конец прокрутка объединять)
        $внутренний{insert внутренний-объект(элемент) начало конец прокрутка объединять}
      (количество элемент начало конец прокрутка объединять)
        $внутренний{insert количество внутренний-объект(элемент) начало конец прокрутка
                               объединять}
    удалить
      начало 'начало
      конец 'назад
      прокрутить? истина
      =
      $внутренний{delete удалить-начало->английский(начало)
                         удалить-конец->английский(конец) прокрутить?}
    только-просмотр значение = $внутренний{lock значение}
    очистить() = $внутренний{erase}
    найти-позицию лево верх  = $внутренний{find-position лево верх}
    найти-кусок позиция направление =
      кусок-адины $внутренний{find-snip позиция направление->английский(направление)}
    найти-строку y = $внутренний{find-line y}
    найти-перевод-строки
      направление 'вперёд
      начало 0
      конец 'конец-файла
      =
      $внутренний{find-newline направление-поиска->английский(направление)
                               начало-поиска->английский(начало)
                               конец-get-text->английский(конец)}
    найти-текст строка
      направление 'вперёд
      начало 0
      конец 'конец-файла
      вернуть-начало? истина
      с-регистром? истина
      =
      $внутренний{find-string строка
                              направление-поиска->английский(направление)
                              начало-поиска->английский(начало)
                              конец-get-text->английский(конец)
                              вернуть-начало? с-регистром?}
    найти-весь-текст строка
      направление 'вперёд
      начало 0
      конец 'конец-файла
      вернуть-начало? истина
      с-регистром? истина
      =
      $внутренний{find-string-all строка
                                  направление-поиска->английский(направление)
                                  начало-поиска->английский(начало)
                                  конец-get-text->английский(конец)
                                  вернуть-начало? с-регистром?}
    изменить-стиль
      стиль-или-отклонение ложь
      начало 'start
      конец 'end
      считать-изменением истина
      =
      $внутренний{change-style внутренний-объект(стиль-или-отклонение)
                               начало конец считать-изменением}
    данные-куска = функция-выбора
      (кусок) $внутренний{get-snip-data внутренний-объект(кусок)}
      (кусок данные) $внутренний{set-snip-data внутренний-объект(кусок) данные}
    обработчик-щелчка начало конец функция отметка(ложь) при-нажатии?(ложь) =
      $внутренний{set-clickback начало конец обработчик-щелчка-адины(функция)
                               внутренний-объект(отметка) при-нажатии?}
    последняя-позиция() = $внутренний{last-position}
    последняя-строка() = $внутренний{last-line}
    последний-абзац() = $внутренний{last-paragraph}
    начало-выделения() = $внутренний{get-start-position}
    конец-выделения() = $внутренний{get-end-position}
    текст
      начало 0
      конец 'конец-файла
      сплющить? ложь
      принудительный-перенос? ложь
      =
      $внутренний{get-text начало конец-get-text->английский(конец)
                               сплющить? принудительный-перенос?}
    литера-позиции позиция = $внутренний{get-character позиция}
    установить-выделение
      начало
      конец 'начало
      в-конце-строки? ложь
      прокрутить? истина
      тип-выделения 'по-умолчанию
      =
      $внутренний{set-position начало конец-set-position->английский(конец)
                               в-конце-строки? прокрутить?
                               тип-выделения->английский(тип-выделения)}
    переместить-позицию код дополнять?(ложь) вид('просто) =
      $внутренний{move-position код-перемещения->английский(код) дополнять?
                                вид-перемещения->английский(вид)}
    начало-строки строка видимый?(истина) =
      $внутренний{line-start-position строка видимый?}
    конец-строки строка видимый?(истина) =
      $внутренний{line-end-position строка видимый?}
    длина-строки строка = $внутренний{line-length строка}
    начало-абзаца абзац видимый?(истина) =
      $внутренний{paragraph-start-position абзац видимый?}
    конец-абзаца абзац видимый?(истина) =
      $внутренний{paragraph-end-position абзац видимый?}
    строка-позиции позиция в-конце-строки?(ложь) =
      $внутренний{position-line позиция в-конце-строки?}
    абзац-позиции позиция в-конце-строки?(ложь) =
      $внутренний{position-paragraph позиция в-конце-строки?}
    прокрутить-к-позиции позиция = $внутренний{scroll-to-position позиция}
    позиция-куска кусок = $внутренний{get-snip-position внутренний-объект(кусок)}
    межстрочный-промежуток = функция-выбора
      () $внутренний{get-line-spacing}
      (значение) $внутренний{set-line-spacing значение}
    липкие-стили = функция-выбора
      () $внутренний{get-styles-sticky}
      (значение) $внутренний{set-styles-sticky значение}
    режим-замены = функция-выбора
      () $внутренний{get-overwrite-mode}
      (значение) $внутренний{set-overwrite-mode значение}
    -- события текст%
    после-вставки начало длина = пусто
    после-удаления начало длина = пусто
    после-объединения-кусков позиция = пусто
    после-изменения-стиля начало длина = пусто
    после-установки-позиции() = пусто
    можно-менять-стиль? начало длина = истина
    можно-удалить? начало длина = истина
    можно-вставить? начало длина = истина
    при-удалении начало длина = пусто
    при-вставке начало длина = пусто
    при-изменении-стиля начало длина = пусто
