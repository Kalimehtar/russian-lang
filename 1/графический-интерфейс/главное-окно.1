#!1
используется класс
  с-префиксом rkt: racket/gui/base
  графический-интерфейс/объект
  графический-интерфейс/интерфейс-окно
  графический-интерфейс/интерфейс-главное-окно
  графический-интерфейс/событие
  графический-интерфейс/меню

предоставлять главное-окно%

стиль-главного-окна->английский список-терминов =
  отобразить
    функция (термин)
      выбор термин
        (без-рамки-изменения-размера) 'no-resize-border
        (без-заголовка) 'no-caption
        (без-системного-меню) 'no-system-menu
        (скрыть-меню) 'hide-menu-bar
        (кнопка-панели) 'toolbar-button
        (плавающее) 'float
        (металлическое) 'metal
        (кнопка-полного-экрана) 'fullscreen-button
        (вспомогательное-полного-экрана) 'fullscreen-aux
    список-терминов

при-компиляции
  имена-методов-окна = отобразить имя-метода методы-окна
  имена-методов-главного-окна = отобразить имя-метода методы-главного-окна

внутренний-главного-окна% = сформировать-код $ #` класс* rkt:frame% (внутренний-адины<%>)
  #,@начало-внутреннего
  переопределить #,@(отобразить имя-метода события-главного-окна)
  переопределить on-toolbar-button-click on-menu-char
  дополнить can-close? on-close display-changed
  #,@события-главного-окна
  display-changed() = получатель-событий{при-изменении-дисплея}
  can-close?() = получатель-событий{можно-закрыть?}
  on-close() = получатель-событий{при-закрытии}
  on-toolbar-button-click() =
    получатель-событий{при-нажатии-кнопки-панели}
  on-menu-char событие =
    ||
      получатель-событий{при-клавише-меню событие-клавиши-адины(событие)}
      базовый(on-menu-char событие)

главное-окно% = сформировать-код $ #` класс* объект-графического-интерфейса% (главное-окно<%>)
  #,@начало
  методы #,@имена-методов-главного-окна создать-строку-состояния \
    показать-состояние есть-строка-состояния? строка-меню \
    полный-экран полный-экран? свернуть свёрнут? развернуть развёрнут? \
    изменён? при-нажатии-кнопки-панели при-клавише-меню
  инициализировать
    #,@инициализация-главного-окна
    $заголовок(заголовок) ""
    $ширина(ширина) ложь
    $высота(высота) ложь
    $лево(лево) ложь
    $верх(верх) ложь
    $стиль(стиль) пустой-список
  $внутренний := объект внутренний-главного-окна%
    получатель-событий этот
    label $заголовок
    width $ширина
    height $высота
    x $лево
    y $верх
    style стиль-главного-окна->английский($стиль)
    #,@внутренняя-инициализация-главного-окна
  #,@методы-главного-окна
  создать-строку-состояния() = $внутренний{create-status-line}
  показать-состояние состояние = $внутренний{set-status-text состояние}
  есть-строка-состояния?() = $внутренний{has-status-line?}
  строка-меню() =
    внутренний = $внутренний{get-menu-bar}
    внутренний && объект строка-меню% внутренний(внутренний)
  полный-экран значение = $внутренний{fullscreen значение}
  полный-экран?() = $внутренний{is-fullscreened?}
  свернуть значение = $внутренний{iconize значение}
  свёрнут?() = $внутренний{is-iconized?}
  развернуть значение = $внутренний{maximize значение}
  развёрнут?() = $внутренний{is-maximized?}
  изменён? = функция-выбора
    () $внутренний{modified}
    (значение) $внутренний{modified значение}
  при-нажатии-кнопки-панели() = пусто
  при-клавише-меню событие = ложь
