#!1
используется класс
предоставлять метод-выбора объект-адины внутренний-объект объект-графического-интерфейса%
предоставлять-для-синтаксиса начало-внутреннего начало имя-метода убрать убрать-инициализацию

определение-синтаксического-правила метод-выбора($внутренний имя)
  функция-выбора
    () $внутренний{имя}
    (новое-значение) $внутренний{имя новое-значение}

объект-адины объект =
  объект && поле получатель-событий объект
  
внутренний-объект объект =
  объект && объект{внутренний}

при-компиляции
  начало-внутреннего = '
    инициализированные-поля получатель-событий
    базовый-объект()
  начало = '
    базовый-объект()
    унаследованные-поля $внутренний    
  имя-метода элемент =
    имя = первый $ оставшиеся элемент
    список? имя ?
      первый имя
      имя
  убрать метод методы =
    если
      пустой?(методы) методы
      (имя-метода первый(методы) == метод)
        оставшиеся методы
      иначе
        пара
          первый методы
          убрать метод оставшиеся(методы)
  имя-пункта элемент =
    первый $ оставшиеся $ первый элемент
  убрать-инициализацию пункт пункты =
    если
      пустой?(пункты) пункты
      (имя-пункта первый(пункты) == пункт)
        оставшиеся пункты
      иначе
        пара
          первый пункты
          убрать-инициализацию пункт оставшиеся(пункты)

объект-графического-интерфейса% = класс объект%
  методы внутренний
  поля
    $внутренний ложь
  инициализировать
    $$внутренний(внутренний) ложь
  если $$внутренний тогда
    $внутренний := $$внутренний
  внутренний() = $внутренний
  базовый-объект()
