#!1
используется класс
  графический-интерфейс/объект
  рисование/цвет
  с-префиксом rkt: racket/gui/base

предоставлять список-стилей% стиль% отклонение-стиля% стиль-адины

при-компиляции
  методы-списка-стилей = '
    базовый-стиль() =
      стиль-адины $внутренний{basic-style}
    найти-по-имени имя =
      стиль-адины $внутренний{find-named-style имя}
    новый-с-именем имя стиль =
      стиль-адины $внутренний{new-named-style имя стиль{внутренний}}
    заменить-с-именем имя стиль =
      стиль-адины $внутренний{replace-named-style имя стиль{внутренний}}
  методы-стиля = '
    установить-отклонение отклонение =
      $внутренний{set-delta отклонение{внутренний}}
    базовый-стиль() =
      стиль-адины $внутренний{get-base-style}
  методы-отклонения = '
    установить-цвет-текста цвет = $внутренний{set-delta-foreground внутренний-цвет(цвет)}
    установить-цвет-фона цвет = $внутренний{set-delta-background внутренний-цвет(цвет)}

список-стилей% = сформировать-код $ #` класс объект-графического-интерфейса%
  #,@начало
  методы #,@(отобразить имя-метода методы-списка-стилей)
  $внутренний := объект rkt:style-list%
  #,@методы-списка-стилей

стиль% = сформировать-код $ #` класс объект-графического-интерфейса%
  #,@начало
  методы #,@(отобразить имя-метода методы-стиля)
  инициализировать
    $$внутренний(внутренний) ложь
  $внутренний := $$внутренний
  #,@методы-стиля

стиль-адины внутренний =
  внутренний && объект стиль% внутренний(внутренний)

отклонение-стиля% = сформировать-код $ #` класс объект-графического-интерфейса%
  #,@начало
  методы #,@(отобразить имя-метода методы-отклонения)
  $внутренний := объект rkt:style-delta%
  #,@методы-отклонения
