#!1
используется класс
  графический-интерфейс/объект
  графический-интерфейс/интерфейс-элемент-управления
  графический-интерфейс/шрифт
  с-префиксом rkt: racket/gui/base

предоставлять полоска%

стиль->английский список-терминов =
  отобразить
    функция (термин)
      выбор термин
        (горизонтальная) 'horizontal
        (вертикальная) 'vertical
        (вертикальный-заголовок) 'vertical-label
        (горизонтальный-заголовок) 'horizontal-label
        (скрытая) 'deleted
    список-терминов

внутренний-полоски% = сформировать-код $ #` класс* rkt:gauge% (внутренний-адины<%>)
  #,@начало-внутреннего
  переопределить #,@(отобразить имя-метода события-элемента-управления)
  #,@события-элемента-управления

полоска% = сформировать-код $ #` класс* объект-графического-интерфейса% (элемент-управления<%>)
  #,@начало
  методы #,@(отобразить имя-метода методы-элемента-управления) значение диапазон
  инициализировать
    $диапазон(диапазон)()
    #,@(убрать-инициализацию 'стиль инициализация-элемента-управления)
    $заголовок(заголовок) ложь
    $стиль(стиль) '(горизонтальная)
  $внутренний := объект внутренний-полоски%
    получатель-событий этот
    label
      внутренний-объект $заголовок
    range $диапазон
    #,@внутренняя-инициализация-элемента-управления
  #,@методы-элемента-управления
  значение = функция-выбора
    () $внутренний{get-value}
    (новое-значение) $внутренний{set-value новое-значение}
  диапазон = функция-выбора
    () $внутренний{get-range}
    (новый-диапазон) $внутренний{set-range новый-диапазон}
