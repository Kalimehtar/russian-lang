                           @racket[пункт-меню%], @racket[всплывающее-меню%]})
               (list @racketidfont{графический-интерфейс/надпись} @racket[надпись%])
               (list @racketidfont{графический-интерфейс/текстовое-поле} @racket[текстовое-поле%])
