#!1
используется
  база-данных
  с-префиксом rkt: db/mysql
  с-префиксом ssl: openssl
  с-префиксом осн: racket/base

предоставлять (всё-из база-данных) подключить угадать-путь-сокета

угадать-путь-сокета() =
  rkt:mysql-guess-socket-path()

добавить-пару пары ключ значение =
  добавить список(список(ключ значение)) пары

вызвать-mysql пары =
  упорядоченные = упорядочить пары осн:keyword<? #:ключ первый
  осн:keyword-apply rkt:mysql-connect
    отобразить первый упорядоченные
    отобразить
      п ==> первый оставшиеся(п)
      упорядоченные
    пустой-список

ключ-англ имя =
  строка->ключевое-слово имя

подключить
  #:пользователь пользователь
  #:база база ложь
  #:сервер сервер «localhost»
  #:порт порт 3306
  #:сокет сокет ложь
  #:пароль пароль ложь
  #:открытый-пароль? открытый-пароль? 'местно
  #:шифрование шифрование 'нет
  #:контекст-шифрования контекст-шифрования ложь
  #:обработчик-уведомлений обработчик-уведомлений пусто
  =
  сокет-англ = выбор сокет
    (угадать) 'guess
    иначе сокет
  шифрование-англ = выбор шифрование
    (нет) 'no
    (да) 'yes
    (необязательно) 'optional
    иначе шифрование
  открытый-англ = выбор открытый-пароль?
    (местно) 'local
    иначе открытый-пароль?
  базовые = список
    список ключ-англ(«user») пользователь
    список ключ-англ(«database») база
    список ключ-англ(«password») пароль
    список ключ-англ(«ssl») шифрование-англ
  с-адресом =
    если сокет-англ тогда
      добавить-пару базовые ключ-англ(«socket») сокет-англ
      иначе
      добавить-пару
        добавить-пару базовые ключ-англ(«server») сервер
        ключ-англ(«port»)
        порт
  с-паролем =
    если открытый-англ === 'local тогда
      с-адресом
      иначе
      добавить-пару с-адресом ключ-англ(«allow-cleartext-password?»)
        открытый-англ
  с-шифрованием =
    если шифрование-англ === 'no тогда
      с-паролем
      иначе
      добавить-пару с-паролем ключ-англ(«ssl-context»)
        (если контекст-шифрования тогда контекст-шифрования
         иначе ssl:ssl-make-client-context())
  с-уведомлением =
    если пусто? обработчик-уведомлений тогда
      с-шифрованием
      иначе
      добавить-пару с-шифрованием ключ-англ(«notice-handler»)
        обработчик-уведомлений
  вызвать-mysql с-уведомлением
