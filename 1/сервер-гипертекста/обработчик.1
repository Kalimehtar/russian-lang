#!1
используется
  с-префиксом rkt: web-server/servlet

предоставлять ответ данные-запроса-отправки/необработанные
предоставлять отправить/приостановить/маршрутизировать
предоставлять ответ/выражение-разметки пустой-запрос параметры-запроса
предоставлять извлечь-параметр/единственный параметры-запроса/необработанные
предоставлять параметр-файла? параметр-файла
предоставлять идентификатор-параметра-файла имя-файла-параметра
предоставлять заголовки-параметра-файла содержимое-параметра-файла
предоставлять параметр-файла/порт? порт-параметра-файла параметр-файла/порт

ответ код сообщение секунды тип-содержимого заголовки вывод =
  rkt:response код сообщение секунды тип-содержимого заголовки вывод

данные-запроса-отправки/необработанные запрос =
  rkt:request-post-data/raw запрос

отправить/приостановить/маршрутизировать генератор =
  rkt:send/suspend/dispatch генератор

ответ/выражение-разметки выражение-разметки
  #:код код 200
  #:сообщение сообщение ложь
  #:секунды секунды сейчас()
  #:тип-содержимого тип-содержимого rkt:TEXT/HTML-MIME-TYPE
  #:куки куки пустой-список
  #:заголовки заголовки пустой-список
  #:преамбула преамбула (новые-байты 0)
  =
  rkt:response/xexpr выражение-разметки
    #:code код
    #:message сообщение
    #:seconds секунды
    #:mime-type тип-содержимого
    #:cookies куки
    #:headers заголовки
    #:preamble преамбула

пустой-запрос
  #:заголовки заголовки пустой-список
  =
  rkt:redirect/get #:headers заголовки

параметры-запроса запрос =
  rkt:request-bindings запрос

извлечь-параметр/единственный имя параметры =
  rkt:extract-binding/single имя параметры

параметры-запроса/необработанные запрос =
  rkt:request-bindings/raw запрос

параметр-файла? значение =
  rkt:binding:file? значение

параметр-файла идентификатор имя-файла заголовки содержимое =
  rkt:make-binding:file идентификатор имя-файла заголовки содержимое

идентификатор-параметра-файла параметр =
  rkt:binding-id параметр

имя-файла-параметра параметр =
  rkt:binding:file-filename параметр

заголовки-параметра-файла параметр =
  rkt:binding:file-headers параметр

содержимое-параметра-файла параметр =
  rkt:binding:file-content параметр

параметр-файла/порт? значение =
  rkt:binding:file/port? значение

порт-параметра-файла параметр =
  rkt:binding:file/port-in параметр

параметр-файла/порт идентификатор имя-файла заголовки порт =
  rkt:make-binding:file/port идентификатор имя-файла заголовки порт
