#!1
используется
  с-префиксом rkt: web-server/servlet-env
  с-префиксом rkt-base: racket/base
  с-префиксом rkt-limits: web-server/safety-limits
  с-префиксом rkt-lru: web-server/managers/lru
  с-префиксом rkt-stuff: web-server/stuffers
  с-префиксом rkt-resp: web-server/configuration/responders
  с-префиксом rkt-http: web-server/http

предоставлять сервер/единственный

сервер/единственный обработчик
  #:командная-строка? командная-строка? ложь
  #:закрывать-соединение? закрывать-соединение? ложь
  #:открывать-браузер? открывать-браузер? (не командная-строка?)
  #:выход? выход? (не командная-строка?)
  #:выводить-сведения? выводить-сведения? (не командная-строка?)
  #:слушать-адрес слушать-адрес «127.0.0.1»
  #:порт порт 8000
  #:наибольшая-очередь наибольшая-очередь 511
  #:пределы-безопасности пределы-безопасности
    rkt-limits:make-safety-limits(#:max-waiting наибольшая-очередь)
  #:управляющий управляющий
    rkt-lru:make-threshold-LRU-manager
      функция (запрос)
        rkt-http:response/xexpr
          '(html
            (head (title «Страница устарела.»))
            (body (p «Эта страница устарела. Вернитесь назад.»)))
      128 * 1024 * 1024
  #:путь-сервлета путь-сервлета «/servlets/standalone.rkt»
  #:регулярное-сервлета регулярное-сервлета
    регулярное-выражение формат("^~a$" rkt-base:regexp-quote(путь-сервлета))
  #:без-состояния? без-состояния? ложь
  #:упаковщик упаковщик rkt-stuff:default-stuffer
  #:пространство-имён-сервлета пространство-имён-сервлета пустой-список
  #:корень-сервера корень-сервера
    rkt-base:collection-path(«web-server» «default-web-root»)
  #:дополнительные-файлы дополнительные-файлы
    список построить-путь(корень-сервера «htdocs»)
  #:корень-сервлетов корень-сервлетов
    построить-путь корень-сервера «htdocs»
  #:текущий-каталог-сервлета текущий-каталог-сервлета корень-сервлетов
  #:ответ-файл-не-найден ответ-файл-не-найден
    rkt-resp:gen-file-not-found-responder
      построить-путь корень-сервера «conf» «not-found.html»
  #:ответ-загрузки-сервлета ответ-загрузки-сервлета
    rkt-resp:servlet-loading-responder
  #:ответ-ошибки-сервлета ответ-ошибки-сервлета
    rkt-resp:servlet-error-responder
  #:путь-типов-содержимого путь-типов-содержимого
    если существует-файл? построить-путь(корень-сервера «mime.types») тогда
      построить-путь корень-сервера «mime.types»
      иначе
      построить-путь
        rkt-base:collection-path(«web-server» «default-web-root»)
        «mime.types»
  #:защищённый? защищённый? ложь
  #:сертификат сертификат
    защищённый? && построить-путь(корень-сервера «server-cert.pem»)
  #:ключ ключ
    защищённый? && построить-путь(корень-сервера «private-key.pem»)
  #:журнал журнал ложь
  #:формат-журнала формат-журнала 'апач-умолчание
  =
  формат-журнала-англ = выбор формат-журнала
    (апач-умолчание) 'apache-default
    (скобочное-умолчание) 'parenthesized-default
    (расширенный) 'extended
    (совмещённый) 'combined
    иначе формат-журнала
  rkt:serve/servlet обработчик
    #:command-line? командная-строка?
    #:connection-close? закрывать-соединение?
    #:launch-browser? открывать-браузер?
    #:quit? выход?
    #:banner? выводить-сведения?
    #:listen-ip слушать-адрес
    #:port порт
    #:max-waiting наибольшая-очередь
    #:safety-limits пределы-безопасности
    #:manager управляющий
    #:servlet-path путь-сервлета
    #:servlet-regexp регулярное-сервлета
    #:stateless? без-состояния?
    #:stuffer упаковщик
    #:servlet-namespace пространство-имён-сервлета
    #:server-root-path корень-сервера
    #:extra-files-paths дополнительные-файлы
    #:servlets-root корень-сервлетов
    #:servlet-current-directory текущий-каталог-сервлета
    #:file-not-found-responder ответ-файл-не-найден
    #:servlet-loading-responder ответ-загрузки-сервлета
    #:servlet-responder ответ-ошибки-сервлета
    #:mime-types-path путь-типов-содержимого
    #:ssl? защищённый?
    #:ssl-cert сертификат
    #:ssl-key ключ
    #:log-file журнал
    #:log-format формат-журнала-англ
