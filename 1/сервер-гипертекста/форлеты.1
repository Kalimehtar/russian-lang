#!1
используется
  с-префиксом rkt: web-server/formlets
  с-префиксом осн: racket/base
  1/syn
используется-для-синтаксиса
  с-префиксом осн: racket/base

предоставлять форлет форлет* лес =>*
предоставлять разметка-форлета обработать-форлет
предоставлять отправить/форлет встроить-форлет
предоставлять создать-ввод создать-ввод* поле-ввода
предоставлять текстовый-ввод ввод-пароля многострочный-ввод
предоставлять флажок-формы переключатель
предоставлять группа-переключателей группа-флажков
предоставлять кнопка-отправки кнопка-сброса
предоставлять загрузка-файла скрытое-поле рисунок-формы кнопка-формы
предоставлять множественный-выбор список-выбора
предоставлять обязательный с-умолчанием
предоставлять в-строку в-число в-символ в-булево
предоставлять ввод-строки ввод-числа ввод-символа

синоним rkt:#%# лес
синоним rkt:=>* =>*

при-компиляции
  замена-имени имя л н нс з =
    осн:case имя
      (лес) л
      (не-буквально) н
      (не-буквально-списком) нс
      (значения) з
      осн:else ложь

  подменить-хвост хвост л н нс з =
    осн:cond
      (осн:null? хвост)
        хвост
      (осн:pair? хвост)
        осн:cons
          подменить-шаблон-форлета осн:car(хвост) л н нс з
          подменить-хвост осн:cdr(хвост) л н нс з
      осн:else
        подменить-шаблон-форлета хвост л н нс з

  подменить-шаблон-форлета stx л н нс з =
    осн:cond
      (осн:identifier? stx)
        осн:let
          ([замена $ замена-имени осн:syntax-e(stx) л н нс з])
          осн:if замена
            осн:datum->syntax замена осн:syntax-e(замена) stx stx
            stx
      (осн:syntax? stx)
        осн:let ([данное $ осн:syntax-e stx])
          осн:cond
            (осн:pair? данное)
              осн:datum->syntax stx
                осн:cons
                  подменить-шаблон-форлета осн:car(данное) л н нс з
                  подменить-хвост осн:cdr(данное) л н нс з
                stx
                stx
            осн:else stx
      осн:else stx

определение-синтаксиса (форлет stx)
  выбор-синтаксиса stx ()
    (_ шаблон выражение)
      #` rkt:formlet
        #,(подменить-шаблон-форлета #'шаблон #'rkt:#%# #'осн:unquote
           #'осн:unquote-splicing #'осн:values)
        выражение

определение-синтаксиса (форлет* stx)
  выбор-синтаксиса stx ()
    (_ шаблон выражение)
      #` rkt:formlet*
        #,(подменить-шаблон-форлета #'шаблон #'rkt:#%# #'осн:unquote
           #'осн:unquote-splicing #'осн:values)
        выражение

разметка-форлета форлет =
  rkt:formlet-display форлет

обработать-форлет форлет запрос =
  rkt:formlet-process форлет запрос

обернуть-форлет-по-умолчанию разметка-формы =
  список 'html
    список 'head список('title «Ввод формы»)
    список 'body разметка-формы

отправить/форлет форлет
  #:метод метод 'отправка
  #:обернуть обернуть обернуть-форлет-по-умолчанию
  =
  метод-англ = выбор метод
    (отправка POST post) «POST»
    (получение GET get) «GET»
    иначе метод
  rkt:send/formlet форлет #:method метод-англ #:wrap обернуть

встроить-форлет встроить форлет =
  rkt:embed-formlet встроить форлет

создать-ввод нарисовать =
  rkt:make-input нарисовать

создать-ввод* нарисовать =
  rkt:make-input* нарисовать

поле-ввода
  #:тип тип «text»
  #:значение значение ложь
  #:наибольшая-длина наибольшая-длина ложь
  #:только-чтение? только-чтение? ложь
  #:атрибуты атрибуты пустой-список
  =
  rkt:input
    #:type тип
    #:value значение
    #:max-length наибольшая-длина
    #:read-only? только-чтение?
    #:attributes атрибуты

текстовый-ввод
  #:значение значение ложь
  #:размер размер ложь
  #:наибольшая-длина наибольшая-длина ложь
  #:только-чтение? только-чтение? ложь
  #:атрибуты атрибуты пустой-список
  =
  rkt:text-input
    #:value значение
    #:size размер
    #:max-length наибольшая-длина
    #:read-only? только-чтение?
    #:attributes атрибуты

ввод-пароля
  #:значение значение ложь
  #:размер размер ложь
  #:наибольшая-длина наибольшая-длина ложь
  #:только-чтение? только-чтение? ложь
  #:атрибуты атрибуты пустой-список
  =
  rkt:password-input
    #:value значение
    #:size размер
    #:max-length наибольшая-длина
    #:read-only? только-чтение?
    #:attributes атрибуты

многострочный-ввод
  #:атрибуты атрибуты пустой-список
  #:значение значение ложь
  #:строки строки ложь
  #:столбцы столбцы ложь
  =
  если
    (&& строки столбцы)
      rkt:textarea-input
        #:attributes атрибуты
        #:value значение
        #:rows строки
        #:cols столбцы
    строки
      rkt:textarea-input
        #:attributes атрибуты
        #:value значение
        #:rows строки
    столбцы
      rkt:textarea-input
        #:attributes атрибуты
        #:value значение
        #:cols столбцы
    иначе
      rkt:textarea-input
        #:attributes атрибуты
        #:value значение

флажок-формы значение отмечен?
  #:атрибуты атрибуты пустой-список
  =
  rkt:checkbox значение отмечен? #:attributes атрибуты

переключатель значение отмечен?
  #:атрибуты атрибуты пустой-список
  =
  rkt:radio значение отмечен? #:attributes атрибуты

группа-переключателей варианты
  #:атрибуты атрибуты (x ==> пустой-список)
  #:отмечен? отмечен? (x ==> ложь)
  #:представить представить (x ==> x)
  #:обернуть обернуть (функция (x y) список(x y))
  =
  rkt:radio-group варианты
    #:attributes атрибуты
    #:checked? отмечен?
    #:display представить
    #:wrap обернуть

группа-флажков варианты
  #:атрибуты атрибуты (x ==> пустой-список)
  #:отмечен? отмечен? (x ==> ложь)
  #:представить представить (x ==> x)
  #:обернуть обернуть (функция (x y) список(x y))
  =
  rkt:checkbox-group варианты
    #:attributes атрибуты
    #:checked? отмечен?
    #:display представить
    #:wrap обернуть

кнопка-отправки подпись
  #:атрибуты атрибуты пустой-список
  =
  rkt:submit подпись #:attributes атрибуты

кнопка-сброса подпись
  #:атрибуты атрибуты пустой-список
  =
  rkt:reset подпись #:attributes атрибуты

загрузка-файла
  #:атрибуты атрибуты пустой-список
  =
  rkt:file-upload #:attributes атрибуты

скрытое-поле значение
  #:атрибуты атрибуты пустой-список
  =
  rkt:hidden значение #:attributes атрибуты

рисунок-формы подпись источник
  #:высота высота ложь
  #:описание описание ложь
  #:карта карта ложь
  #:ширина ширина ложь
  #:атрибуты атрибуты пустой-список
  =
  rkt:img подпись источник
    #:height высота
    #:longdesc описание
    #:usemap карта
    #:width ширина
    #:attributes атрибуты

кнопка-формы тип текст
  #:отключена? отключена? ложь
  #:значение значение ложь
  #:атрибуты атрибуты пустой-список
  =
  rkt:button тип текст
    #:disabled отключена?
    #:value значение
    #:attributes атрибуты

множественный-выбор варианты
  #:атрибуты атрибуты пустой-список
  #:несколько? несколько? истина
  #:выбран? выбран? (x ==> ложь)
  #:представить представить (x ==> x)
  =
  rkt:multiselect-input варианты
    #:attributes атрибуты
    #:multiple? несколько?
    #:selected? выбран?
    #:display представить

список-выбора варианты
  #:атрибуты атрибуты пустой-список
  #:выбран? выбран? (x ==> ложь)
  #:представить представить (x ==> x)
  =
  rkt:select-input варианты
    #:attributes атрибуты
    #:selected? выбран?
    #:display представить

обязательный форлет =
  rkt:required форлет

с-умолчанием умолчание форлет =
  rkt:default умолчание форлет

в-строку форлет =
  rkt:to-string форлет

в-число форлет =
  rkt:to-number форлет

в-символ форлет =
  rkt:to-symbol форлет

в-булево форлет =
  rkt:to-boolean форлет

ввод-строки = rkt:input-string
ввод-числа = rkt:input-int
ввод-символа = rkt:input-symbol
