#!1
системная
используется базовая/функция
  с-префиксом rkt: racket/base
предоставлять путь? строка->путь путь->строка построить-путь разделить-путь

путь? объект =
  rkt:path? объект

строка->путь строка =
  rkt:string->path строка

путь->строка путь =
  rkt:path->string путь

построить-путь база . элементы =
  применить rkt:build-path база элементы

разделить-путь путь =
  rkt:split-path путь
