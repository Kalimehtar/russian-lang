#!1
системная
используется
  с-префиксом rkt: racket/base
предоставлять регулярное-выражение расширенное-регулярное-выражение \
  совпадение-с-регулярным-выражением совпадения-с-регулярным-выражением \
  совпадает-с-регулярным-выражением? заменить-по-регулярному-выражению \
  заменить-по-регулярному-выражению/все разделить-по-регулярному-выражению

регулярное-выражение строка =
  rkt:if
    rkt:string? строка 
    rkt:regexp строка
    rkt:byte-regexp строка

расширенное-регулярное-выражение строка =
  rkt:if
    rkt:string? строка 
    rkt:pregexp строка
    rkt:byte-pregexp строка

совпадение-с-регулярным-выражением регулярное-выражение строка =
  rkt:regexp-match регулярное-выражение строка

совпадения-с-регулярным-выражением регулярное-выражение строка =
  rkt:regexp-match* регулярное-выражение строка

совпадает-с-регулярным-выражением? регулярное-выражение строка =
  rkt:regexp-match? регулярное-выражение строка

заменить-по-регулярному-выражению регулярное-выражение строка замена =
  rkt:regexp-replace регулярное-выражение строка замена

заменить-по-регулярному-выражению/все регулярное-выражение строка замена =
  rkt:regexp-replace* регулярное-выражение строка замена

разделить-по-регулярному-выражению регулярное-выражение строка =
  rkt:regexp-split регулярное-выражение строка