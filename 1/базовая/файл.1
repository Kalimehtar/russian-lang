#!1
системная
используется
  с-префиксом rkt: racket/base
  с-префиксом file: racket/file
  базовая/управление
  базовая/синтаксис
предоставлять текущий-каталог существует-каталог? существует-файл? существует-ссылка? \
  тип-файла-или-каталога создать-каталог в-каталоге удалить-файл \
  переименовать-файл-или-каталог секунды-изменения-файла-или-каталога \
  права-файла-или-каталога информация-файла-или-каталога \
  идентификатор-файла-или-каталога размер-файла копировать-файл \
  создать-ссылку-на-файл-или-каталог удалить-каталог удалить-каталог/файлы

текущий-каталог() = rkt:current-directory()

существует-каталог? путь =
  rkt:directory-exists? путь

существует-файл? путь =
  rkt:file-exists? путь

существует-ссылка? путь =
  rkt:link-exists? путь

тип-файла-или-каталога путь должен-существовать?(ложь) =
  выбор (rkt:file-or-directory-type путь должен-существовать?)
    (file) 'файл
    (directory) 'каталог
    (link) 'ссылка
    (directory-link) 'ссылка-на-каталог
    иначе ложь

создать-каталог путь права(#o777) =
  rkt:make-directory путь права

в-каталоге каталог(ложь) =
  rkt:in-directory каталог

удалить-файл путь =
  rkt:delete-file путь

переименовать-файл-или-каталог старый новый существование-допустимо?(ложь) =
  rkt:rename-file-or-directory старый новый существование-допустимо?

секунды-изменения-файла-или-каталога путь секунды(ложь) при-ошибке(ложь) =
  если
    при-ошибке
      rkt:file-or-directory-modify-seconds путь секунды при-ошибке
    иначе
      rkt:file-or-directory-modify-seconds путь секунды

права-файла-или-каталога путь режим(ложь) =
  rkt:file-or-directory-permissions путь
    выбор режим
      (биты) 'bits
      иначе режим

информация-файла-или-каталога путь как-ссылка?(ложь) =
  rkt:file-or-directory-stat путь как-ссылка?

идентификатор-файла-или-каталога путь как-ссылка?(ложь) =
  rkt:file-or-directory-identity путь как-ссылка?

размер-файла путь =
  rkt:file-size путь

копировать-файл источник назначение
  #:существование-допустимо? существование-допустимо? ложь
  #:права права ложь
  #:заменить-права? заменить-права? истина
  =
  rkt:copy-file источник назначение
    #:exists-ok? существование-допустимо?
    #:permissions права
    #:replace-permissions? заменить-права?

создать-ссылку-на-файл-или-каталог куда путь =
  rkt:make-file-or-directory-link куда путь

удалить-каталог путь =
  rkt:delete-directory путь

удалить-каталог/файлы путь
  #:должен-существовать? должен-существовать? истина
  =
  file:delete-directory/files путь #:must-exist? должен-существовать?
