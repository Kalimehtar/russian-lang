#!1
используется
  строка
  с-префиксом rkt: racket/base
  с-префиксом rktd: racket/date

предоставлять дата% дата секунда минута час день месяц год день-недели день-года летнее-время? \
  временная-зона наносекунда секунды->дата дата->строка дата->секунды начало-дня конец-дня \
  начало-месяца конец-месяца начало-года конец-года добавить-месяц

структура дата%
  (секунда минута час день месяц год день-недели день-года летнее-время? временная-зона наносекунда)
  #:читаемая
  #:префикс ||

секунды->дата секунды =
  шаблон
    rkt:date* секунда минута час день месяц год день-недели день-года летнее-время? временная-зона
      наносекунда
      имя-зоны
    =
    rkt:seconds->date секунды
  дата% секунда минута час день месяц год день-недели день-года летнее-время? временная-зона
    наносекунда

дата год(1) месяц(1) день(1) час(0) минута(0) секунда(0) наносекунда(0) =
  копия-структуры дата% 
    секунды->дата
      rktd:find-seconds секунда минута час день месяц год истина
    наносекунда наносекунда

дата->секунды дата =
  секунды = rktd:find-seconds
    секунда дата
    минута дата
    час дата
    день дата
    месяц дата
    год дата
    ложь
  секунды - временная-зона дата
 
дата->строка дата =
  формат «~a.~a.~a ~a:~a:~a~a»
    число->строка-длины 2
      день дата
    число->строка-длины 2
      месяц дата
    число->строка-длины 4
      год дата
    число->строка-длины 2
      час дата
    число->строка-длины 2
      минута дата
    число->строка-длины 2
      секунда дата
    наносекунда дата == 0 ?
      «»
      «.» ++ число->строка-длины 9 наносекунда(дата)

начало-дня дата =
  копия-структуры дата% дата час(0) минута(0) секунда(0) наносекунда(0)

конец-дня дата совсем(ложь) =
  копия-структуры дата% дата час(23) минута(59) секунда(59)
    наносекунда
      совсем ? 999999999 0

начало-месяца %дата =
  дата
    год %дата
    месяц %дата
    1

-- без корректировки конца месяца
добавить-месяц% дата количество =
  %месяц = месяц дата + количество % 12
  %год = год дата + количество // 12
  копия-структуры дата% дата
    год %год
    месяц %месяц
    
конец-месяца %дата совсем(ложь) =
  начало-следующего = начало-месяца
    добавить-месяц% %дата 1
  последняя-секунда = секунды->дата
    дата->секунды начало-следующего - 1
  совсем ?
    копия-структуры дата% последняя-секунда
      наносекунда 999999999
    последняя-секунда

начало-года %дата =
  дата
    год %дата
    1
    1

конец-года дата =
  конец-месяца
    копия-структуры дата% дата месяц(12)

добавить-месяц дата количество =
  предварительно = добавить-месяц% дата количество
  последний-день = день $ конец-месяца предварительно
  если день предварительно <= последний-день тогда
    предварительно
    иначе
    копия-структуры дата% предварительно
      день последний-день
