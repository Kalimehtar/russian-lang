#!1
используется
  с-префиксом rkt: racket/udp

предоставлять открыть закрыть соединение? привязано? соединено? привязать соединить \
  отправить-на отправить отправить-на* отправить* \
  отправить-на/с-прерыванием отправить/с-прерыванием \
  получить получить* получить/с-прерыванием \
  установить-размер-буфера-приёма адреса \
  событие-готовности-отправки событие-готовности-приёма \
  событие-отправки-на событие-отправки событие-приёма \
  время-жизни установить-время-жизни \
  войти-в-группу выйти-из-группы \
  групповой-интерфейс установить-групповой-интерфейс \
  групповой-возврат? установить-групповой-возврат \
  групповое-время-жизни установить-групповое-время-жизни

открыть имя-сервера(ложь) номер-порта(ложь) =
  rkt:udp-open-socket имя-сервера номер-порта

закрыть соединение =
  rkt:udp-close соединение

соединение? значение =
  rkt:udp? значение

привязано? соединение =
  rkt:udp-bound? соединение

соединено? соединение =
  rkt:udp-connected? соединение

привязать соединение имя-сервера номер-порта повторно?(ложь) =
  rkt:udp-bind! соединение имя-сервера номер-порта повторно?

соединить соединение имя-сервера номер-порта =
  rkt:udp-connect! соединение имя-сервера номер-порта

отправить-на соединение имя-сервера номер-порта байты
  начало 0
  конец длина-байтов(байты)
  =
  rkt:udp-send-to соединение имя-сервера номер-порта байты начало конец

отправить соединение байты начало(0) конец(длина-байтов(байты)) =
  rkt:udp-send соединение байты начало конец

отправить-на* соединение имя-сервера номер-порта байты
  начало 0
  конец длина-байтов(байты)
  =
  rkt:udp-send-to* соединение имя-сервера номер-порта байты начало конец

отправить* соединение байты начало(0) конец(длина-байтов(байты)) =
  rkt:udp-send* соединение байты начало конец

отправить-на/с-прерыванием соединение имя-сервера номер-порта байты
  начало 0
  конец длина-байтов(байты)
  =
  rkt:udp-send-to/enable-break соединение имя-сервера номер-порта байты начало конец

отправить/с-прерыванием соединение байты начало(0) конец(длина-байтов(байты)) =
  rkt:udp-send/enable-break соединение байты начало конец

получить соединение байты начало(0) конец(длина-байтов(байты)) =
  rkt:udp-receive! соединение байты начало конец

получить* соединение байты начало(0) конец(длина-байтов(байты)) =
  rkt:udp-receive!* соединение байты начало конец

получить/с-прерыванием соединение байты начало(0) конец(длина-байтов(байты)) =
  rkt:udp-receive!/enable-break соединение байты начало конец

установить-размер-буфера-приёма соединение размер =
  rkt:udp-set-receive-buffer-size! соединение размер

событие-готовности-отправки соединение =
  rkt:udp-send-ready-evt соединение

событие-готовности-приёма соединение =
  rkt:udp-receive-ready-evt соединение

событие-отправки-на соединение имя-сервера номер-порта байты
  начало 0
  конец длина-байтов(байты)
  =
  rkt:udp-send-to-evt соединение имя-сервера номер-порта байты начало конец

событие-отправки соединение байты начало(0) конец(длина-байтов(байты)) =
  rkt:udp-send-evt соединение байты начало конец

событие-приёма соединение байты начало(0) конец(длина-байтов(байты)) =
  rkt:udp-receive!-evt соединение байты начало конец

адреса соединение номера-портов?(ложь) =
  rkt:udp-addresses соединение номера-портов?

время-жизни соединение =
  rkt:udp-ttl соединение

установить-время-жизни соединение значение =
  rkt:udp-set-ttl! соединение значение

войти-в-группу соединение адрес-группы имя-сервера =
  rkt:udp-multicast-join-group! соединение адрес-группы имя-сервера

выйти-из-группы соединение адрес-группы имя-сервера =
  rkt:udp-multicast-leave-group! соединение адрес-группы имя-сервера

групповой-интерфейс соединение =
  rkt:udp-multicast-interface соединение

установить-групповой-интерфейс соединение имя-сервера =
  rkt:udp-multicast-set-interface! соединение имя-сервера

групповой-возврат? соединение =
  rkt:udp-multicast-loopback? соединение

установить-групповой-возврат соединение значение =
  rkt:udp-multicast-set-loopback! соединение значение

групповое-время-жизни соединение =
  rkt:udp-multicast-ttl соединение

установить-групповое-время-жизни соединение значение =
  rkt:udp-multicast-set-ttl! соединение значение
