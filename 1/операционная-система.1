#!1
используется 
  с-префиксом rkt: net/sendurl
  с-префиксом rkt-gui: racket/gui/base
  с-префиксом rkt-base: racket/base

предоставлять открыть-страницу-Интернета воспроизвести-звук завершить-работу \
  запущено-в-DrRacket?

открыть-страницу-Интернета строка-адреса =
  rkt:send-url строка-адреса

воспроизвести-звук
  файл
  асинхронно? ложь
  =
  rkt-gui:play-sound файл асинхронно?

завершить-работу значение(истина) =
  rkt-base:exit значение

-- Исполняемый файл DrRacket — это lib/GRacket.exe, как и у собранной
-- программы. Различает только обработчик выхода, который ставит DrRacket.
запущено-в-DrRacket?() =
  обработчик = rkt-base:object-name $ rkt-base:exit-handler()
  rkt-base:eq? обработчик 'drracket-exit-handler
