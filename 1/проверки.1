#!1
системная
используется
  с-префиксом rkt: rackunit
  с-префиксом rkt: racket/base
  базовая/синтаксис
используется-для-синтаксиса
  базовая/синтаксис

предоставлять проверки проверить проверить-равно? проверить-не-равно? \
  проверить-эквивалентно? проверить-не-эквивалентно? \
  проверить-eq? проверить-не-eq? \
  проверить-истину проверить-ложь проверить-не-ложь \
  проверить-предикатом проверить-= проверить-в-пределах \
  проверить-исключение проверить-без-исключения проверить-шаблон \
  проверка-случая начало-проверки набор-проверок

определение-синтаксического-правила (проверки тело ...)
  (rkt:module+ test тело ...)

проверить оператор значение1 значение2 сообщение(ложь) =
  rkt:check оператор значение1 значение2 сообщение

проверить-равно? значение1 значение2 сообщение(ложь) =
  rkt:check-equal? значение1 значение2 сообщение

проверить-не-равно? значение1 значение2 сообщение(ложь) =
  rkt:check-not-equal? значение1 значение2 сообщение

проверить-эквивалентно? значение1 значение2 сообщение(ложь) =
  rkt:check-eqv? значение1 значение2 сообщение

проверить-не-эквивалентно? значение1 значение2 сообщение(ложь) =
  rkt:check-not-eqv? значение1 значение2 сообщение

проверить-eq? значение1 значение2 сообщение(ложь) =
  rkt:check-eq? значение1 значение2 сообщение

проверить-не-eq? значение1 значение2 сообщение(ложь) =
  rkt:check-not-eq? значение1 значение2 сообщение

проверить-истину значение сообщение(ложь) =
  rkt:check-true значение сообщение

проверить-ложь значение сообщение(ложь) =
  rkt:check-false значение сообщение

проверить-не-ложь значение сообщение(ложь) =
  rkt:check-not-false значение сообщение

проверить-предикатом предикат значение сообщение(ложь) =
  rkt:check-pred предикат значение сообщение

проверить-= значение1 значение2 эпсилон сообщение(ложь) =
  rkt:check-= значение1 значение2 эпсилон сообщение

проверить-в-пределах значение1 значение2 эпсилон сообщение(ложь) =
  rkt:check-within значение1 значение2 эпсилон сообщение

проверить-исключение условие действие сообщение(ложь) =
  rkt:check-exn условие действие сообщение

проверить-без-исключения действие сообщение(ложь) =
  rkt:check-not-exn действие сообщение

определение-синтаксиса (проверить-шаблон stx)
  выбор-синтаксиса stx ()
    (_ значение шаблон)
      #'(rkt:check-match значение шаблон)
    (_ значение шаблон условие)
      #'(rkt:check-match значение шаблон условие)

определение-синтаксического-правила (проверка-случая имя тело ...)
  (rkt:test-case имя тело ...)

определение-синтаксического-правила (начало-проверки тело ...)
  (rkt:test-begin тело ...)

определение-синтаксического-правила (набор-проверок имя тело ...)
  (rkt:test-suite имя тело ...)
