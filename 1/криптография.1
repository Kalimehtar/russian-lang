; --- фабрики ---

фабрика-криптографической-библиотеки? значение =
  rkt:crypto-factory? значение

фабрики-криптографических-библиотек = rkt:crypto-factories

фабрика-реализации реализация =
  rkt:get-factory реализация

версия-фабрики фабрика =
  rkt:factory-version фабрика

сведения-фабрики фабрика =
  rkt:factory-print-info фабрика

все-фабрики = all:all-factories

использовать-все-фабрики() =
  all:use-all-factories!()

фабрика-libcrypto = lc:libcrypto-factory
фабрика-gcrypt = gc:gcrypt-factory
фабрика-nettle = nt:nettle-factory
фабрика-sodium = na:sodium-factory
фабрика-b2 = b2:b2-factory
фабрика-argon2 = ar:argon2-factory
фабрика-decaf = dc:decaf-factory

; --- отпечатки ---

спецификация-отпечатка? значение =
  rkt:digest-spec? значение

реализация-отпечатка? значение =
  rkt:digest-impl? значение

получить-отпечаток спецификация
  фабрики фабрики-криптографических-библиотек()
  =
  rkt:get-digest спецификация фабрики

размер-отпечатка спецификация =
  rkt:digest-size спецификация

размер-блока-отпечатка спецификация =
  rkt:digest-block-size спецификация

стойкость-отпечатка спецификация устойчивость-к-коллизиям? =
  rkt:digest-security-strength спецификация устойчивость-к-коллизиям?

создать-ключ-отпечатка-hmac спецификация =
  rkt:generate-hmac-key спецификация

отпечаток спецификация вход #:ключ ключ(ложь) =
  rkt:digest спецификация вход #:key ключ

отпечаток-hmac спецификация ключ вход =
  rkt:hmac спецификация ключ вход

контекст-отпечатка спецификация #:ключ ключ(ложь) =
  rkt:make-digest-ctx спецификация #:key ключ

контекст-отпечатка? значение =
  rkt:digest-ctx? значение

обновить-отпечаток контекст вход =
  rkt:digest-update контекст вход

завершить-отпечаток контекст =
  rkt:digest-final контекст

копия-отпечатка контекст =
  rkt:digest-copy контекст

подсмотреть-отпечаток контекст =
  rkt:digest-peek-final контекст

контекст-отпечатка-hmac спецификация ключ =
  rkt:make-hmac-ctx спецификация ключ

; --- симметричное шифрование ---

спецификация-шифра? значение =
  rkt:cipher-spec? значение

реализация-шифра? значение =
  rkt:cipher-impl? значение

получить-шифр спецификация
  фабрики фабрики-криптографических-библиотек()
  =
  rkt:get-cipher спецификация фабрики

размер-блока-шифра шифр =
  rkt:cipher-block-size шифр

размер-ключа-шифра шифр =
  rkt:cipher-default-key-size шифр

размеры-ключа-шифра шифр =
  rkt:cipher-key-sizes шифр

размер-вектора-инициализации шифр =
  rkt:cipher-iv-size шифр

шифр-с-проверкой-подлинности? шифр =
  rkt:cipher-aead? шифр

размер-проверки-подлинности-шифра шифр =
  rkt:cipher-default-auth-size шифр

создать-ключ-шифра шифр
  #:размер размер размер-ключа-шифра(шифр)
  =
  rkt:generate-cipher-key шифр #:size размер

создать-вектор-инициализации шифр
  #:размер размер размер-вектора-инициализации(шифр)
  =
  rkt:generate-cipher-iv шифр #:size размер

зашифровать/с-доп шифр ключ ви вход доп разм допл =
  rkt:encrypt шифр ключ ви вход #:aad доп #:auth-size разм #:pad допл

зашифровать/без-доп шифр ключ ви вход разм допл =
  rkt:encrypt шифр ключ ви вход #:auth-size разм #:pad допл

зашифровать шифр ключ вектор-инициализации вход
  #:размер-проверки-подлинности размер-проверки-подлинности
    размер-проверки-подлинности-шифра(шифр)
  #:дополнение дополнение истина
  #:дополнительные-данные дополнительные-данные #""
  =
  если шифр-с-проверкой-подлинности? шифр тогда
    зашифровать/с-доп шифр ключ вектор-инициализации вход
      дополнительные-данные; размер-проверки-подлинности; дополнение
    иначе
    зашифровать/без-доп шифр ключ вектор-инициализации вход
      размер-проверки-подлинности; дополнение

расшифровать/с-доп шифр ключ ви вход доп разм допл =
  rkt:decrypt шифр ключ ви вход #:aad доп #:auth-size разм #:pad допл

расшифровать/без-доп шифр ключ ви вход разм допл =
  rkt:decrypt шифр ключ ви вход #:auth-size разм #:pad допл

расшифровать шифр ключ вектор-инициализации вход
  #:размер-проверки-подлинности размер-проверки-подлинности
    размер-проверки-подлинности-шифра(шифр)
  #:дополнение дополнение истина
  #:дополнительные-данные дополнительные-данные #""
  =
  если шифр-с-проверкой-подлинности? шифр тогда
    расшифровать/с-доп шифр ключ вектор-инициализации вход
      дополнительные-данные; размер-проверки-подлинности; дополнение
    иначе
    расшифровать/без-доп шифр ключ вектор-инициализации вход
      размер-проверки-подлинности; дополнение

зашифровать/пд/с-доп шифр ключ ви вход доп разм допл =
  rkt:encrypt/auth шифр ключ ви вход #:aad доп #:auth-size разм #:pad допл

зашифровать/пд/без-доп шифр ключ ви вход разм допл =
  rkt:encrypt/auth шифр ключ ви вход #:auth-size разм #:pad допл

зашифровать/проверка-подлинности шифр ключ вектор-инициализации вход
  #:размер-проверки-подлинности размер-проверки-подлинности
    размер-проверки-подлинности-шифра(шифр)
  #:дополнение дополнение истина
  #:дополнительные-данные дополнительные-данные #""
  =
  если шифр-с-проверкой-подлинности? шифр тогда
    зашифровать/пд/с-доп шифр ключ вектор-инициализации вход
      дополнительные-данные; размер-проверки-подлинности; дополнение
    иначе
    зашифровать/пд/без-доп шифр ключ вектор-инициализации вход
      размер-проверки-подлинности; дополнение

расшифровать/пд/с-доп шифр ключ ви вход доп метка допл =
  rkt:decrypt/auth шифр ключ ви вход #:aad доп #:auth-tag метка #:pad допл

расшифровать/пд/без-доп шифр ключ ви вход метка допл =
  rkt:decrypt/auth шифр ключ ви вход #:auth-tag метка #:pad допл

расшифровать/проверка-подлинности шифр ключ вектор-инициализации вход
  #:дополнение дополнение истина
  #:дополнительные-данные дополнительные-данные #""
  #:проверка-подлинности проверка-подлинности #""
  =
  если шифр-с-проверкой-подлинности? шифр тогда
    расшифровать/пд/с-доп шифр ключ вектор-инициализации вход
      дополнительные-данные; проверка-подлинности; дополнение
    иначе
    расшифровать/пд/без-доп шифр ключ вектор-инициализации вход
      проверка-подлинности; дополнение

контекст-шифрования шифр ключ вектор-инициализации
  #:размер-проверки-подлинности размер-проверки-подлинности
    размер-проверки-подлинности-шифра(шифр)
  #:проверка-подлинности-прикреплена? проверка-подлинности-прикреплена?
    истина
  #:дополнение дополнение истина
  =
  rkt:make-encrypt-ctx шифр ключ вектор-инициализации
    #:auth-size размер-проверки-подлинности
    #:auth-attached? проверка-подлинности-прикреплена?
    #:pad дополнение

контекст-расшифрования шифр ключ вектор-инициализации
  #:размер-проверки-подлинности размер-проверки-подлинности
    размер-проверки-подлинности-шифра(шифр)
  #:проверка-подлинности-прикреплена? проверка-подлинности-прикреплена?
    истина
  #:дополнение дополнение истина
  =
  rkt:make-decrypt-ctx шифр ключ вектор-инициализации
    #:auth-size размер-проверки-подлинности
    #:auth-attached? проверка-подлинности-прикреплена?
    #:pad дополнение

контекст-шифра? значение =
  rkt:cipher-ctx? значение

контекст-шифрования? значение =
  rkt:encrypt-ctx? значение

контекст-расшифрования? значение =
  rkt:decrypt-ctx? значение

обновить-шифр контекст вход =
  rkt:cipher-update контекст вход

обновить-дополнительные-данные-шифра контекст вход =
  rkt:cipher-update-aad контекст вход

завершить-шифр контекст проверка-подлинности(ложь) =
  rkt:cipher-final контекст проверка-подлинности

проверка-подлинности-шифра контекст =
  rkt:cipher-get-auth-tag контекст

; --- открытый ключ ---

спецификация-открытого-ключа? значение =
  rkt:pk-spec? значение

реализация-открытого-ключа? значение =
  rkt:pk-impl? значение

получить-открытый-ключ спецификация
  фабрики фабрики-криптографических-библиотек()
  =
  rkt:get-pk спецификация фабрики

открытый-ключ-умеет-подписывать? ключ =
  rkt:pk-can-sign? ключ

открытый-ключ-умеет-шифровать? ключ =
  rkt:pk-can-encrypt? ключ

открытый-ключ-умеет-согласовывать? ключ =
  rkt:pk-can-key-agree? ключ

открытый-ключ-с-параметрами? ключ =
  rkt:pk-has-parameters? ключ

открытый-ключ? значение =
  rkt:pk-key? значение

закрытый-ключ? значение =
  rkt:private-key? значение

только-открытый-ключ? значение =
  rkt:public-only-key? значение

параметры-открытого-ключа? значение =
  rkt:pk-parameters? значение

открытый-ключ->параметры ключ =
  rkt:pk-key->parameters ключ

стойкость-открытого-ключа ключ =
  rkt:pk-security-strength ключ

открытые-ключи=? ключ1 . остальные =
  применить rkt:public-key=? ключ1 остальные

открытый-ключ->только-открытый ключ =
  rkt:pk-key->public-only-key ключ

создать-параметры-открытого-ключа спецификация
  конфигурация пустой-список
  =
  rkt:generate-pk-parameters спецификация конфигурация

создать-закрытый-ключ спецификация
  конфигурация пустой-список
  =
  rkt:generate-private-key спецификация конфигурация

подписать-открытым-ключом ключ сообщение
  #:дополнение дополнение ложь
  #:отпечаток отпечаток ложь
  =
  rkt:pk-sign ключ сообщение #:pad дополнение #:digest отпечаток

проверить-открытым-ключом ключ сообщение подпись
  #:отпечаток отпечаток ложь
  #:дополнение дополнение ложь
  =
  rkt:pk-verify ключ сообщение подпись
    #:digest отпечаток
    #:pad дополнение

отпечаток/подписать ключ спецификация-отпечатка вход
  #:дополнение дополнение ложь
  =
  rkt:digest/sign ключ спецификация-отпечатка вход #:pad дополнение

отпечаток/проверить ключ спецификация-отпечатка вход подпись
  #:дополнение дополнение ложь
  =
  rkt:digest/verify ключ спецификация-отпечатка вход подпись
    #:pad дополнение

подписать-отпечаток-открытым-ключом ключ спецификация-отпечатка
  отпечаток-байты
  #:дополнение дополнение ложь
  =
  rkt:pk-sign-digest ключ спецификация-отпечатка отпечаток-байты
    #:pad дополнение

проверить-отпечаток-открытым-ключом ключ спецификация-отпечатка
  отпечаток-байты
  подпись
  #:дополнение дополнение ложь
  =
  rkt:pk-verify-digest ключ спецификация-отпечатка отпечаток-байты
    подпись
    #:pad дополнение

зашифровать-открытым-ключом ключ сообщение
  #:дополнение дополнение ложь
  =
  rkt:pk-encrypt ключ сообщение #:pad дополнение

расшифровать-открытым-ключом ключ сообщение
  #:дополнение дополнение ложь
  =
  rkt:pk-decrypt ключ сообщение #:pad дополнение

вывести-секрет-открытым-ключом ключ ключ-собеседника =
  rkt:pk-derive-secret ключ ключ-собеседника

открытый-ключ->данные ключ формат =
  rkt:pk-key->datum ключ формат

данные->открытый-ключ данные формат
  источники фабрики-криптографических-библиотек()
  =
  rkt:datum->pk-key данные формат источники

параметры-открытого-ключа->данные параметры формат =
  rkt:pk-parameters->datum параметры формат

данные->параметры-открытого-ключа данные формат
  источники фабрики-криптографических-библиотек()
  =
  rkt:datum->pk-parameters данные формат источники

зашифровать-pkcs8/pbkdf2-hmac пароль ключ
  #:отпечаток отпечаток 'sha512
  #:итерации итерации 65536
  #:шифр шифр '(aes cbc)
  #:размер-ключа размер-ключа размер-ключа-шифра(шифр)
  =
  p8:pkcs8-encrypt/pbkdf2-hmac пароль ключ
    #:digest отпечаток
    #:iterations итерации
    #:cipher шифр
    #:key-size размер-ключа

зашифровать-pkcs8/scrypt пароль ключ
  #:N N 16384
  #:r r 8
  #:p p 1
  #:шифр шифр '(aes cbc)
  #:размер-ключа размер-ключа размер-ключа-шифра(шифр)
  =
  p8:pkcs8-encrypt/scrypt пароль ключ
    #:N N
    #:r r
    #:p p
    #:cipher шифр
    #:key-size размер-ключа

расшифровать-pkcs8-байты пароль данные =
  p8:pkcs8-decrypt-bytes пароль данные

расшифровать-pkcs8-ключ пароль данные =
  p8:pkcs8-decrypt-key пароль данные

; --- вывод ключа и пароли ---

спецификация-вывода-ключа? значение =
  rkt:kdf-spec? значение

реализация-вывода-ключа? значение =
  rkt:kdf-impl? значение

получить-вывод-ключа спецификация
  фабрики фабрики-криптографических-библиотек()
  =
  rkt:get-kdf спецификация фабрики

вывод-ключа спецификация вход соль
  параметры пустой-список
  #:размер-ключа размер-ключа ложь
  =
  rkt:kdf спецификация вход соль параметры #:key-size размер-ключа

хэш-пароля спецификация пароль конфигурация =
  rkt:pwhash спецификация пароль конфигурация

проверить-хэш-пароля реализация пароль хэш =
  rkt:pwhash-verify реализация пароль хэш

ключ-pbkdf2-hmac спецификация пароль соль
  #:итерации итерации
  #:размер-ключа размер-ключа размер-отпечатка(спецификация)
  =
  rkt:pbkdf2-hmac спецификация пароль соль
    #:iterations итерации
    #:key-size размер-ключа

ключ-scrypt пароль соль
  #:N N
  #:p p 1
  #:r r 8
  #:размер-ключа размер-ключа 32
  =
  rkt:scrypt пароль соль #:N N #:p p #:r r #:key-size размер-ключа

; --- утилиты ---

вход-криптографии/с = rkt:input/c

диапазон-байтов = rkt:bytes-range

случайные-байты-криптографии число =
  rkt:crypto-random-bytes число

стойкость/с = rkt:security-strength/c

уровень-стойкости/с = rkt:security-level/c

уровень-стойкости->стойкость уровень =
  rkt:security-level->strength уровень

стойкость->уровень-стойкости стойкость =
  rkt:security-strength->level стойкость
