#!1
используется строка
предоставлять представление-числа представление-единицы

представление-единицы число описание-единицы =
  элемент-массива описание-единицы
    выбор-формы число

выбор-формы число =
  остаток-10 = число % 10
  остаток-100 = число % 100
  если
    (остаток-10 == 1 && остаток-100 /= 11)
      0
    (<= 2 остаток-10 4 && (остаток-100 < 10 || остаток-100 >= 20))
      1
    иначе 2

-- возвращает представление числа
--   число -- целое неотрицательное число
--   описание-единицы -- массив с элементами
--              строка -- форма для одной единицы
--              строка -- форма для двух-четырёх единиц
--              строка -- форма для много единиц
--              символ -- род единицы: 'мужской, 'женский, 'средний
--     примеры:
--       массив «рубль» «рубля» «рублей» 'мужской
--       массив «копейка» «копейки» «копеек» 'женский
--       массив «ведро» «ведра» «вёдер» 'средний
представление-числа число
  описание-единицы
    массив «» «» «» 'мужской
  =
  если
    строка?(число)
      число1 = строка->число число
      если точное-целое? число1 тогда
        представление-числа число1 описание-единицы
        иначе
        вызвать-ошибку-аргумента 'представление-числа
          «строка, которую можно прочитать как целое число»
          число
    (не точное-целое? число)
      вызвать-ошибку-аргумента 'представление-числа
        «целое число»
        число
    (число == 0)
      описание-единицы ?
        «ноль » ++ описание-единицы[2]
        «ноль»
    (число < 0)
      вызвать-ошибку-аргумента 'представление-числа «неотрицательное число» число
    (число > 999999999999)
      вызвать-ошибку-аргумента 'представление-числа «число меньше триллиона» число
    иначе
      объединить $ развернуть
        цикл/список
          для
            триплет $ в-списке триплеты(число)
            номер-триплета от-нуля()
          триплет->строка триплет
            номер-триплета == 0 ?
              описание-единицы
              имена-триплетов[номер-триплета - 1]

триплеты число =
  значения частное остаток = частное/остаток число 1000
  частное == 0 ?
    список остаток
    пара остаток триплеты(частное)

объединить список =
  объединить-строки
    отобрать
      функция (строка)
        строка /= «»
      список
    « »

триплет->строка триплет имя-триплета =
  род = имя-триплета[3]
  значения не-единицы единицы = частное/остаток триплет 10
  значения сотни десятки = частное/остаток не-единицы 10
  объединить $ список
    имена-сотен[сотни]
    имена-десятков[десятки]
    элемент-массива
      если
        (десятки == 1) имена-до-20
        (род == 'женский && единицы < 3) имена-до-10-женские
        (род == 'средний && единицы < 2) имена-до-10-средние
        иначе имена-до-10-мужские
      единицы
    триплет == 0 ?
      «»
      представление-единицы триплет имя-триплета

имена-до-10-мужские = массив "" "один" "два" "три" "четыре" "пять" "шесть" "семь"  "восемь" "девять"
имена-до-10-женские = массив "" "одна" "две"
имена-до-10-средние = массив "" "одно"
имена-до-20 = массив "десять" "одиннадцать" "двенадцать" "тринадцать" "четырнадцать" \
  "пятнадцать" "шестнадцать" "семнадцать" "восемнадцать" "девятнадцать"
имена-десятков = массив "" "" "двадцать" "тридцать" "сорок" "пятьдесят" "шестьдесят" \
  "семьдесят" "восемьдесят" "девяносто"
имена-сотен = массив "" "сто" "двести" "триста" "четыреста" "пятьсот" "шестьсот" \
  "семьсот" "восемьсот" "девятьсот"

имена-триплетов = массив                      
  массив «тысяча» «тысячи» «тысяч» 'женский
  массив «миллион» «миллиона» «миллионов» 'мужской
  массив «миллиард» «миллиарда» «миллиардов» 'мужской
