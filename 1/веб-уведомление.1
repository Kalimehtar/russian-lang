#!1
используется
  криптография
  с-префиксом b64: формат-base64
  с-префиксом json: формат-json
  сервер-гипертекста/формат-url
  клиент-гипертекста
  порт
  строка

предоставлять отправить-веб-уведомление

фабрики-криптографических-библиотек список(фабрика-libcrypto)

декодировать-base64url строка =
  доп-длина = (4 - длина-строки(строка) % 4) % 4
  стандарт =
    заменить-по-регулярному-выражению/все #rx"-"
      заменить-по-регулярному-выражению/все #rx"_"
        добавить-строки строка новая-строка(доп-длина #\=)
        «/»
      «+»
  b64:из-байтов строка->байты(стандарт)

кодировать-base64url байты =
  закодированные = b64:в-байты байты
  байты->строка
    заменить-по-регулярному-выражению/все #rx#"=+$"
      заменить-по-регулярному-выражению/все #rx#"/"
        заменить-по-регулярному-выражению/все #rx#"\\+"
          закодированные
          #"-"
        #"_"
      #""

байты->большое-целое байты =
  рекурсивно
    шаг
      позиция 0
      нак 0
    если позиция >= длина-байтов(байты) тогда
      нак
      иначе
      шаг
        позиция + 1
        нак * 256 + элемент-байтов байты позиция

отрезать-ведущие-нули байты =
  если длина-байтов(байты) == 0 тогда
    новые-байты 1 0
    иначе
    если
      &&
        длина-байтов байты > 1
        элемент-байтов байты 0 == 0
      тогда
      отрезать-ведущие-нули подбайты(байты 1)
      иначе
      байты

выровнять-32 байты =
  длина = длина-байтов байты
  если длина == 32 тогда
    байты
    иначе
    если длина < 32 тогда
      добавить-байты
        новые-байты (32 - длина) 0
        байты
      иначе
      подбайты байты (длина - 32)

дер-ecdsa->сырые дер =
  ввод = открыть-чтение-из-байтов дер
  прочитать-длину =
    функция ()
      б = прочитать-байт(ввод)
      если конец-файла?(б) тогда
        ошибка 'der «eof in len»
        иначе
        если б < 128 тогда
          б
          иначе
          бс = прочитать-байты (б - 128) ввод
          доп =
            добавить-байты
              новые-байты (4 - длина-байтов(бс)) 0
              бс
          байты->целое доп ложь истина
  прочитать-целое =
    функция ()
      если прочитать-байт(ввод) /= #x02 тогда
        ошибка 'der «expected INTEGER»
        иначе
        выровнять-32
          отрезать-ведущие-нули
            прочитать-байты прочитать-длину() ввод
  если прочитать-байт(ввод) /= #x30 тогда
    ошибка 'der «expected SEQUENCE»
    иначе
    прочитать-длину()
    добавить-байты прочитать-целое() прочитать-целое()

ключ-vapid личный-b64 публичный-b64 =
  пуб = декодировать-base64url публичный-b64
  личный-целое =
    байты->большое-целое декодировать-base64url(личный-b64)
  данные->открытый-ключ
    список
      'ec
      'private
      список(1 2 840 10045 3 1 7)
      пуб
      личный-целое
    'rkt-private

сделать-vapid-jwt личный-b64 публичный-b64 аудитория тема
  время-жизни 43200
  =
  заголовок-b64 =
    кодировать-base64url
      строка->байты $ json:в-строку $ соответствие=== 'typ «JWT» 'alg «ES256»
  нагрузка-b64 =
    кодировать-base64url
      строка->байты
        json:в-строку
          соответствие===
            'aud
            аудитория
            'exp
            сейчас() + время-жизни
            'sub
            тема
  вход-подписи =
    добавить-байты
      строка->байты заголовок-b64
      #"."
      строка->байты нагрузка-b64
  дер-подпись =
    подписать-открытым-ключом
      ключ-vapid личный-b64 публичный-b64
      отпечаток 'sha256 вход-подписи
      #:отпечаток ложь
  добавить-строки
    заголовок-b64
    «.»
    нагрузка-b64
    «.»
    кодировать-base64url дер-ecdsa->сырые(дер-подпись)

начало-службы-доставки адрес =
  u = строка->url адрес
  схема = схема-url u
  узел = узел-url u
  если || (не схема) (не узел) тогда
    ошибка 'отправить-веб-уведомление «плохой адрес: ~a» адрес
  добавить-строки схема «://» узел

узел+путь-из-url адрес =
  u = строка->url адрес
  узел = узел-url u
  защищённый? = схема-url u == «https»
  порт =
    ||
      порт-url u
      если защищённый? тогда 443 иначе 80
  части =
    отобразить
      сегмент ==> формат «~a» путь-сегмента(сегмент)
      путь-url u
  путь =
    если пустой?(части) тогда
      «/»
      иначе
      добавить-строки «/» объединить-строки(части «/»)
  запрос = параметры-url u
  путь+запрос =
    если пустой?(запрос) тогда
      путь
      иначе
      добавить-строки путь «?» список-пар->кодирование-url(запрос)
  значения узел путь+запрос защищённый? порт

отправить-веб-уведомление адрес
  #:публичный-ключ публичный-ключ
  #:личный-ключ личный-ключ
  #:тема тема «mailto:admin@localhost»
  #:время-жизни время-жизни 60
  =
  аудитория = начало-службы-доставки адрес
  jwt = сделать-vapid-jwt личный-ключ публичный-ключ аудитория тема
  значения узел путь защищённый? порт = узел+путь-из-url адрес
  заголовки =
    список
      формат «Authorization: vapid t=~a, k=~a» jwt публичный-ключ
      формат «TTL: ~a» время-жизни
      «Content-Length: 0»
  значения статус _заголовки ввод =
    отправить-получить-гипертекст узел путь
      #:защищённый? защищённый?
      #:порт порт
      #:метод 'отправка
      #:заголовки заголовки
      #:данные #""
  тело = порт->строка ввод
  закрыть-порт-ввода ввод
  список статус тело
