#!1
используется 
  с-префиксом rkt: racket/base

предоставлять отпечаток отпечаток-sha1 отпечаток-sha224 отпечаток-sha256

отпечаток-sha1 порт начало(0) конец(ложь) =
  rkt:sha1-bytes порт начало конец

отпечаток-sha224 порт начало(0) конец(ложь) =
  rkt:sha224-bytes порт начало конец

отпечаток-sha256 порт начало(0) конец(ложь) =
  rkt:sha256-bytes порт начало конец

отпечаток = отпечаток-sha256
