#!1
используется
  с-префиксом rkt: racket/string
предоставлять заменить-в-строке объединить-строки обрезать-строку строка-начинается-с? \
  строка-заканчивается-на? число->строка-длины

заменить-в-строке строка что на-что (#:все? все #t) =
  rkt:string-replace строка что на-что #:all? все

обрезать-строку строка
  разделитель #px"\\s+"
  #:слева? слева? истина
  #:справа? справа? истина
  #:повторять? повторять? ложь
  =
  rkt:string-trim строка разделитель #:left? слева? #:right? справа? #:repeat? повторять?

объединить-строки список (разделитель " ") =
  rkt:string-join список разделитель

строка-начинается-с? строка подстрока =
  rkt:string-prefix? строка подстрока

строка-заканчивается-на? строка подстрока =
  rkt:string-suffix? строка подстрока

число->строка-длины длина число =
  строка = число->строка число
  не-хватает = длина - длина-строки строка
  если не-хватает > 0 тогда
    новая-строка не-хватает #\0 ++ строка
    иначе
    строка
