бесконечность = строка->число «+inf.0»

перевести-изоляцию изоляция =
  выбор изоляция
    (сериализуемая) 'serializable
    (повторяемое-чтение) 'repeatable-read
    (чтение-подтверждённое) 'read-committed
    (чтение-неподтверждённое) 'read-uncommitted
    иначе изоляция

перевести-схему схема =
  выбор схема
    (поиск) 'search
    (текущая) 'current
    (поиск-или-текущая) 'search-or-current
    иначе схема

перевести-режим-группировки режим =
  отобразить
    символ ==> выбор символ
      (список) 'list
      (сохранить-нуль) 'preserve-null
      иначе символ
    режим

предел-пула() =
  ошибка 'взять-из-пула «исчерпан предел пула подключений»

подключение? значение =
  rkt:connection? значение

отключить подключение =
  rkt:disconnect подключение

подключено? подключение =
  rkt:connected? подключение

система-бд подключение =
  rkt:connection-dbsystem подключение

система-бд? значение =
  rkt:dbsystem? значение

имя-системы-бд система =
  rkt:dbsystem-name система

типы-системы-бд система =
  rkt:dbsystem-supported-types система

устойчивое-подключение подключение =
  rkt:kill-safe-connection подключение

выполнить-запрос подключение запрос . аргументы =
  применить rkt:query-exec подключение запрос аргументы

строки-запроса подключение запрос
  #:группировка группировка пустой-список
  #:режим-группировки режим-группировки пустой-список
  . аргументы
  =
  применить rkt:query-rows подключение запрос аргументы
    #:group группировка
    #:group-mode перевести-режим-группировки(режим-группировки)

список-запроса подключение запрос . аргументы =
  применить rkt:query-list подключение запрос аргументы

строка-запроса подключение запрос . аргументы =
  применить rkt:query-row подключение запрос аргументы

возможная-строка-запроса подключение запрос . аргументы =
  применить rkt:query-maybe-row подключение запрос аргументы

значение-запроса подключение запрос . аргументы =
  применить rkt:query-value подключение запрос аргументы

возможное-значение-запроса подключение запрос . аргументы =
  применить rkt:query-maybe-value подключение запрос аргументы

запрос подключение запрос . аргументы =
  применить rkt:query подключение запрос аргументы

в-запросе подключение запрос
  #:пачка пачка бесконечность
  #:группировка группировка пустой-список
  #:режим-группировки режим-группировки пустой-список
  . аргументы
  =
  применить rkt:in-query подключение запрос аргументы
    #:fetch пачка
    #:group группировка
    #:group-mode перевести-режим-группировки(режим-группировки)

запрос? значение =
  rkt:statement? значение

простой-результат сведения =
  rkt:simple-result сведения

простой-результат? значение =
  rkt:simple-result? значение

сведения-простого-результата значение =
  rkt:simple-result-info значение

результат-строк заголовки строки =
  rkt:rows-result заголовки строки

результат-строк? значение =
  rkt:rows-result? значение

заголовки-результата-строк значение =
  rkt:rows-result-headers значение

строки-результата-строк значение =
  rkt:rows-result-rows значение

сгруппировать-строки результат
  #:группировка группировка
  #:режим-группировки режим-группировки пустой-список
  =
  rkt:group-rows результат
    #:group группировка
    #:group-mode перевести-режим-группировки(режим-группировки)

строки->соответствие результат
  #:ключ ключ
  #:значение значение
  #:режим-значения режим-значения пустой-список
  =
  rkt:rows->dict результат
    #:key ключ
    #:value значение
    #:value-mode перевести-режим-группировки(режим-значения)

подготовить подключение запрос =
  rkt:prepare подключение запрос

подготовленный-запрос? значение =
  rkt:prepared-statement? значение

типы-параметров-подготовленного-запроса запрос =
  rkt:prepared-statement-parameter-types запрос

типы-результата-подготовленного-запроса запрос =
  rkt:prepared-statement-result-types запрос

связать-подготовленный-запрос запрос параметры =
  rkt:bind-prepared-statement запрос параметры

связанный-запрос? значение =
  rkt:statement-binding? значение

виртуальный-запрос описание =
  rkt:virtual-statement описание

виртуальный-запрос? значение =
  rkt:virtual-statement? значение

начать-транзакцию подключение
  #:изоляция изоляция ложь
  #:параметр параметр ложь
  =
  rkt:start-transaction подключение
    #:isolation перевести-изоляцию(изоляция)
    #:option параметр

зафиксировать-транзакцию подключение =
  rkt:commit-transaction подключение

откатить-транзакцию подключение =
  rkt:rollback-transaction подключение

в-транзакции? подключение =
  rkt:in-transaction? подключение

нужен-откат? подключение =
  rkt:needs-rollback? подключение

вызывая-транзакцию подключение обработка
  #:изоляция изоляция ложь
  #:параметр параметр ложь
  =
  rkt:call-with-transaction подключение обработка
    #:isolation перевести-изоляцию(изоляция)
    #:option параметр

список-таблиц подключение
  #:схема схема 'поиск-или-текущая
  =
  rkt:list-tables подключение #:schema перевести-схему(схема)

существует-таблица? подключение имя
  #:схема схема 'поиск-или-текущая
  #:учитывать-регистр? учитывать-регистр? ложь
  =
  rkt:table-exists? подключение имя
    #:schema перевести-схему(схема)
    #:case-sensitive? учитывать-регистр?

пул-подключений создать
  #:наибольше-подключений наибольше-подключений бесконечность
  #:наибольше-простоя наибольше-простоя 10
  #:секунды-простоя секунды-простоя 300
  =
  rkt:connection-pool создать
    #:max-connections наибольше-подключений
    #:max-idle-connections наибольше-простоя
    #:max-idle-seconds секунды-простоя

пул-подключений? значение =
  rkt:connection-pool? значение

взять-из-пула пул
  освобождение текущий-поток()
  #:таймаут таймаут ложь
  #:если-нет если-нет предел-пула
  =
  rkt:connection-pool-lease пул освобождение
    #:timeout таймаут
    #:fail если-нет

виртуальное-подключение создать =
  rkt:virtual-connection создать

нуль = rkt:sql-null

нуль? значение =
  rkt:sql-null? значение

нуль->ложь значение =
  rkt:sql-null->false значение

ложь->нуль значение =
  rkt:false->sql-null значение

дата год месяц день =
  rkt:sql-date год месяц день

дата? значение =
  rkt:sql-date? значение

год значение =
  rkt:sql-date-year значение

месяц значение =
  rkt:sql-date-month значение

день значение =
  rkt:sql-date-day значение

время час минута секунда наносекунда зона =
  rkt:sql-time час минута секунда наносекунда зона

время? значение =
  rkt:sql-time? значение

час значение =
  rkt:sql-time-hour значение

минута значение =
  rkt:sql-time-minute значение

секунда значение =
  rkt:sql-time-second значение

наносекунда значение =
  rkt:sql-time-nanosecond значение

зона значение =
  rkt:sql-time-tz значение

метка-времени год месяц день час минута секунда наносекунда зона =
  rkt:sql-timestamp год месяц день час минута секунда наносекунда зона

метка-времени? значение =
  rkt:sql-timestamp? значение

год-метки-времени значение =
  rkt:sql-timestamp-year значение

месяц-метки-времени значение =
  rkt:sql-timestamp-month значение

день-метки-времени значение =
  rkt:sql-timestamp-day значение

час-метки-времени значение =
  rkt:sql-timestamp-hour значение

минута-метки-времени значение =
  rkt:sql-timestamp-minute значение

секунда-метки-времени значение =
  rkt:sql-timestamp-second значение

наносекунда-метки-времени значение =
  rkt:sql-timestamp-nanosecond значение

зона-метки-времени значение =
  rkt:sql-timestamp-tz значение

интервал годы месяцы дни часы минуты секунды наносекунды =
  rkt:sql-interval годы месяцы дни часы минуты секунды наносекунды

интервал? значение =
  rkt:sql-interval? значение

годы значение =
  rkt:sql-interval-years значение

месяцы значение =
  rkt:sql-interval-months значение

дни значение =
  rkt:sql-interval-days значение

часы значение =
  rkt:sql-interval-hours значение

минуты значение =
  rkt:sql-interval-minutes значение

секунды значение =
  rkt:sql-interval-seconds значение

наносекунды значение =
  rkt:sql-interval-nanoseconds значение

интервал-год-месяц? значение =
  rkt:sql-year-month-interval? значение

интервал-день-время? значение =
  rkt:sql-day-time-interval? значение

интервал->время интервал =
  rkt:sql-interval->sql-time интервал

время->интервал время =
  rkt:sql-time->sql-interval время

дата-из-базы-данных значение =
  д:дата
    год значение
    месяц значение
    день значение

дата-в-базу-данных значение =
  дата
    д:год значение
    д:месяц значение
    д:день значение

метка-времени-из-базы-данных значение =
  преобразованная = д:дата
    год-метки-времени значение
    месяц-метки-времени значение
    день-метки-времени значение
    час-метки-времени значение
    минута-метки-времени значение
    секунда-метки-времени значение
    наносекунда-метки-времени значение
  зона = зона-метки-времени значение
  если зона === ложь тогда
    преобразованная
    иначе
    копия-структуры д:дата% преобразованная
      временная-зона зона

метка-времени-в-базу-данных значение =
  метка-времени
    д:год значение
    д:месяц значение
    д:день значение
    д:час значение
    д:минута значение
    д:секунда значение
    д:наносекунда значение
    д:временная-зона значение

ошибка-базы-данных? значение =
  rkt:exn:fail:sql? значение

состояние-ошибки-базы-данных значение =
  rkt:exn:fail:sql-sqlstate значение

сведения-ошибки-базы-данных значение =
  rkt:exn:fail:sql-info значение
